<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background_dark"
    android:padding="8dp">

    <!-- Header: Title & Next Prayer Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/next_prayer_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الصلاة القادمة"
            android:textColor="@android:color/system_accent1_500"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="start" />

        <TextView
            android:id="@+id/next_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العصر"
            android:textColor="@android:color/system_neutral1_100"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Center Countdown / Time Box -->
    <LinearLayout
        android:id="@+id/next_prayer_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/active_prayer_background"
        android:padding="8dp">

        <Chronometer
            android:id="@+id/next_prayer_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/system_neutral1_900"
            android:textSize="28sp"
            android:textStyle="bold"
            android:countDown="true"
            android:format="%s"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/next_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:visibility="gone"
            android:textColor="@android:color/system_neutral1_900"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_prayer_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="الوقت المتبقي"
            android:textColor="@android:color/system_neutral1_900"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
