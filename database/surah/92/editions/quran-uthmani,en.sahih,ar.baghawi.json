2c\u0652\u0632\u064e\u0649\u0670\u0653","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0628\u0652\u062a\u0650\u063a\u064e\u0627\u0653\u0621\u064e \u0648\u064e\u062c\u0652\u0647\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650 \u0671\u0644\u0652\u0623\u064e\u0639\u0652\u0644\u064e\u0649\u0670","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"\u0648\u064e\u0644\u064e\u0633\u064e\u0648\u0652\u0641\u064e \u064a\u064e\u0631\u0652\u0636\u064e\u0649\u0670","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":92,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0644\u0651\u064e\u064a\u06e1\u0644\u0650","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"By the night when it covers","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6060,"text":"And [by] the day when it appears","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6061,"text":"And [by] He who created the male and female,","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6062,"text":"Indeed, your efforts are diverse.","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6063,"text":"As for he who gives and fears Allah","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6064,"text":"And believes in the best [reward],","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6065,"text":"We will ease him toward ease.","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6066,"text":"But as for he who withholds and considers himself free of need","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6067,"text":"And denies the best [reward],","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6068,"text":"We will ease him toward difficulty.","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6069,"text":"And what will his wealth avail him when he falls?","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6070,"text":"Indeed, [incumbent] upon Us is guidance.","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6071,"text":"And indeed, to Us belongs the Hereafter and the first [life].","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6072,"text":"So I have warned you of a Fire which is blazing.","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6073,"text":"None will [enter to] burn therein except the most wretched one.","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6074,"text":"Who had denied and turned away.","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6075,"text":"But the righteous one will avoid it -","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6076,"text":"[He] who gives [from] his wealth to purify himself","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6077,"text":"And not [giving] for anyone who has [done him] a favor to be rewarded","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"But only seeking the countenance of his Lord, Most High.","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"And he is going to be satisfied.","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":92,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0644\u0651\u064e\u064a\u06e1\u0644\u0650","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"\u0645\u0643\u064a\u0629\"\u0648\u0627\u0644\u0644\u064a\u0644 \u0625\u0630\u0627 \u064a\u063a\u0634\u0649\"\u060c \u0623\u064a \u064a\u063a\u0634\u0649 \u0627\u0644\u0646\u0647\u0627\u0631 \u0628\u0638\u0644\u0645\u0629 \u0641\u064a\u0630\u0647\u0628 \u0628\u0636\u0648\u0626\u0647.\n","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6060,"text":"\"\u0648\u0627\u0644\u0646\u0647\u0627\u0631 \u0625\u0630\u0627 \u062a\u062c\u0644\u0649\"\u060c \u0628\u0627\u0646 \u0648\u0638\u0647\u0631 \u0645\u0646 \u0628\u064a\u0646 \u0627\u0644\u0638\u0644\u0645\u0629.\n","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6061,"text":"( \u0648\u0645\u0627 \u062e\u0644\u0642 \u0627\u0644\u0630\u0643\u0631 \u0648\u0627\u0644\u0623\u0646\u062b\u0649 ) \u064a\u0639\u0646\u064a : \u0648\u0645\u0646 \u062e\u0644\u0642 \u060c \u0642\u064a\u0644 \u0647\u064a \" \u0645\u0627 \" \u0627\u0644\u0645\u0635\u062f\u0631\u064a\u0629 \u0623\u064a : \u0648\u062e\u0644\u0642 \u0627\u0644\u0630\u0643\u0631 \u0648\u0627\u0644\u0623\u0646\u062b\u0649 \u060c \u0642\u0627\u0644 \u0645\u0642\u0627\u062a\u0644 \u0648\u0627\u0644\u0643\u0644\u0628\u064a : \u064a\u0639\u0646\u064a \u0622\u062f\u0645 \u0648\u062d\u0648\u0627\u0621 . \u0648\u0641\u064a \u0642\u0631\u0627\u0621\u0629 \u0627\u0628\u0646 \u0645\u0633\u0639\u0648\u062f \u060c \u0648\u0623\u0628\u064a \u0627\u0644\u062f\u0631\u062f\u0627\u0621 : \u0648\u0627\u0644\u0630\u0643\u0631 \u0648\u0627\u0644\u0623\u0646\u062b\u0649 .\n","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6062,"text":"\u062c\u0648\u0627\u0628 \u0627\u0644\u0642\u0633\u0645 \u0642\u0648\u0644\u0647 : ( \u0625\u0646 \u0633\u0639\u064a\u0643\u0645 \u0644\u0634\u062a\u0649 ) \u0625\u0646 \u0623\u0639\u0645\u0627\u0644\u0643\u0645 \u0644\u0645\u062e\u062a\u0644\u0641\u0629 \u060c \u0641\u0633\u0627\u0639 \u0641\u064a \u0641\u0643\u0627\u0643 \u0646\u0641\u0633\u0647 \u060c \u0648\u0633\u0627\u0639 \u0641\u064a \u0639\u0637\u0628\u0647\u0627 .\u0631\u0648\u0649 \u0623\u0628\u0648 \u0645\u0627\u0644\u0643 \u0627\u0644\u0623\u0634\u0639\u0631\u064a \u0642\u0627\u0644 : \u0642\u0627\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - : \" \u0643\u0644 \u060c \u0627\u0644\u0646\u0627\u0633 \u064a\u063a\u062f\u0648 \u0641\u0628\u0627\u0626\u0639 \u0646\u0641\u0633\u0647 \u0641\u0645\u0639\u062a\u0642\u0647\u0627 \u0623\u0648 \u0645\u0648\u0628\u0642\u0647\u0627 \" .\n","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6063,"text":"\"\u0641\u0623\u0645\u0627 \u0645\u0646 \u0623\u0639\u0637\u0649\"\u060c \u0645\u0627\u0644\u0647 \u0641\u064a \u0633\u0628\u064a\u0644 \u0627\u0644\u0644\u0647\u060c \"\u0648\u0627\u062a\u0642\u0649\"\u060c \u0631\u0628\u0647.\n","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6064,"text":"( \u0648\u0635\u062f\u0642 \u0628\u0627\u0644\u062d\u0633\u0646\u0649 ) \u0642\u0627\u0644 \u0623\u0628\u0648 \u0639\u0628\u062f \u0627\u0644\u0631\u062d\u0645\u0646 \u0627\u0644\u0633\u0644\u0645\u064a \u0648\u0627\u0644\u0636\u062d\u0627\u0643 : \u0648\u0635\u062f\u0642 \u0628\u0644\u0627 \u0625\u0644\u0647 \u0625\u0644\u0627\u200c \u0627\u0644\u0644\u0647 \u060c \u0648\u0647\u064a \u0631\u0648\u0627\u064a\u0629 \u0639\u0637\u064a\u0629 \u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 .\u0648\u0642\u0627\u0644 \u0645\u062c\u0627\u0647\u062f : \u0628\u0627\u0644\u062c\u0646\u0629 \u062f\u0644\u064a\u0644\u0647 : \u0642\u0648\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \" \u0644\u0644\u0630\u064a\u0646 \u0623\u062d\u0633\u0646\u0648\u0627 \u0627\u0644\u062d\u0633\u0646\u0649 \" \u064a\u0639\u0646\u064a \u0627\u0644\u062c\u0646\u0629 .\u0648\u0642\u064a\u0644 : \u0648\u0635\u062f\u0642 \u0628\u0627\u0644\u062d\u0633\u0646\u0649 \u0623\u064a \u0628\u0627\u0644\u062e\u0644\u0641 \u060c \u0623\u064a \u0623\u064a\u0642\u0646 \u0623\u0646 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0633\u064a\u062e\u0644\u0641\u0647 . \u0648\u0647\u064a \u0631\u0648\u0627\u064a\u0629 \u0639\u0643\u0631\u0645\u0629 \u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 .\u0648\u0642\u0627\u0644 \u0642\u062a\u0627\u062f\u0629 \u0648\u0645\u0642\u0627\u062a\u0644 \u0648\u0627\u0644\u0643\u0644\u0628\u064a : \u0628\u0645\u0648\u0639\u0648\u062f \u0627\u0644\u0644\u0647 - \u0639\u0632 \u0648\u062c\u0644 - \u0627\u0644\u0630\u064a \u0648\u0639\u062f\u0647 \u0623\u0646 \u064a\u062b\u064a\u0628\u0647 .\n","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6065,"text":"\"\u0641\u0633\u0646\u064a\u0633\u0631\u0647\"\u060c \u0641\u0633\u0646\u0647\u064a\u0626\u0647 \u0641\u064a \u0627\u0644\u062f\u0646\u064a\u0627\u060c \"\u0644\u0644\u064a\u0633\u0631\u0649\"\u060c \u0623\u064a \u0644\u0644\u062e\u0644\u0629 \u0627\u0644\u064a\u0633\u0631\u0649\u060c \u0648\u0647\u064a \u0627\u0644\u0639\u0645\u0644 \u0628\u0645\u0627 \u064a\u0631\u0636\u0627\u0647 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648\u062c\u0644.\n","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6066,"text":"\"\u0648\u0623\u0645\u0627 \u0645\u0646 \u0628\u062e\u0644\"\u060c \u0628\u0627\u0644\u0646\u0641\u0642\u0629 \u0641\u064a \u0627\u0644\u062e\u064a\u0631\u060c \"\u0648\u0627\u0633\u062a\u063a\u0646\u0649\"\u060c \u0639\u0646 \u062b\u0648\u0627\u0628 \u0627\u0644\u0644\u0647 \u0641\u0644\u0645 \u064a\u0631\u063a\u0628 \u0641\u064a\u0647.\n","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6067,"text":"\"\u0648\u0643\u0630\u0628 \u0628\u0627\u0644\u062d\u0633\u0646\u0649\".\n","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6068,"text":"\"\u0641\u0633\u0646\u064a\u0633\u0631\u0647 \u0644\u0644\u0639\u0633\u0631\u0649\" \u0633\u0646\u0647\u064a\u0626\u0647 \u0644\u0644\u0634\u0631 \u0628\u0623\u0646 \u0646\u062c\u0631\u064a\u0647 \u0639\u0644\u0649 \u064a\u062f\u064a\u0647 \u062d\u062a\u0649 \u064a\u0639\u0645\u0644 \u0628\u0645\u0627 \u0644\u0627 \u064a\u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u060c \u0641\u064a\u0633\u062a\u0648\u062c\u0628 \u0628\u0647 \u0627\u0644\u0646\u0627\u0631 . \u0642\u0627\u0644 \u0645\u0642\u0627\u062a\u0644 : \u0646\u0639\u0633\u0631 \u0639\u0644\u064a\u0647 \u0623\u0646 \u064a\u0623\u062a\u064a \u062e\u064a\u0631\u0627 .\u0648\u0631\u0648\u064a\u0646\u0627 \u0639\u0646 \u0639\u0644\u064a \u0639\u0646 \u0627\u0644\u0646\u0628\u064a - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u0642\u0627\u0644 : \" \u0645\u0627 \u0645\u0646 \u0646\u0641\u0633 \u0645\u0646\u0641\u0648\u0633\u0629 \u0625\u0644\u0627 [ \u0643\u062a\u0628 \u0627\u0644\u0644\u0647 ] \u0645\u0643\u0627\u0646\u0647\u0627 \u0645\u0646 \u0627\u0644\u062c\u0646\u0629 \u0623\u0648 \u0627\u0644\u0646\u0627\u0631 \" \u0641\u0642\u0627\u0644 \u0631\u062c\u0644 : \u0623\u0641\u0644\u0627 \u0646\u062a\u0643\u0644 \u0639\u0644\u0649 \u0643\u062a\u0627\u0628\u0646\u0627 \u0648\u0646\u062f\u0639 \u0627\u0644\u0639\u0645\u0644 \u061f \u0642\u0627\u0644 : \" \u0644\u0627 \u0648\u0644\u0643\u0646 \u0627\u0639\u0645\u0644\u0648\u0627 \u0641\u0643\u0644 \u0645\u064a\u0633\u0631 \u0644\u0645\u0627 \u062e\u0644\u0642 \u0644\u0647 \u060c \u0623\u0645\u0627 \u0623\u0647\u0644 \u0627\u0644\u0634\u0642\u0627\u0621 \u0641\u064a\u064a\u0633\u0631\u0648\u0646 \u0644\u0639\u0645\u0644 \u0623\u0647\u0644 \u0627\u0644\u0634\u0642\u0627\u0621 \u060c \u0648\u0623\u0645\u0627 \u0623\u0647\u0644 \u0627\u0644\u0633\u0639\u0627\u062f\u0629 \u0641\u064a\u064a\u0633\u0631\u0648\u0646 \u0644\u0639\u0645\u0644 \u0623\u0647\u0644 \u0627\u0644\u0633\u0639\u0627\u062f\u0629 \" \u060c \u062b\u0645 \u062a\u0644\u0627 \" \u0641\u0623\u0645\u0627 \u0645\u0646 \u0623\u0639\u0637\u0649 \u0648\u0627\u062a\u0642\u0649 \u0648\u0635\u062f\u0642 \u0628\u0627\u0644\u062d\u0633\u0646\u0649 \u0641\u0633\u0646\u064a\u0633\u0631\u0647 \u0644\u0644\u064a\u0633\u0631\u0649 \u0648\u0623\u0645\u0627 \u0645\u0646 \u0628\u062e\u0644 \u0648\u0627\u0633\u062a\u063a\u0646\u0649 \u0648\u0643\u0630\u0628 \u0628\u0627\u0644\u062d\u0633\u0646\u0649 \u0641\u0633\u0646\u064a\u0633\u0631\u0647 \u0644\u0644\u0639\u0633\u0631\u0649 \" .\u0642\u064a\u0644 : \u0646\u0632\u0644\u062a \u0641\u064a \u0623\u0628\u064a \u0628\u0643\u0631 \u0627\u0644\u0635\u062f\u064a\u0642 \u0627\u0634\u062a\u0631\u0649 \u0628\u0644\u0627\u0644\u0627 \u0645\u0646 \u0623\u0645\u064a\u0629 \u0628\u0646 \u062e\u0644\u0641 \u0628\u0628\u0631\u062f\u0629 \u0648\u0639\u0634\u0631\u0629 \u0623\u0648\u0627\u0642 \u060c \u0641\u0623\u0639\u062a\u0642\u0647 \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 : \" \u0648\u0627\u0644\u0644\u064a\u0644 \u0625\u0630\u0627 \u064a\u063a\u0634\u0649 \" \u0625\u0644\u0649 \u0642\u0648\u0644\u0647 : \" \u0625\u0646 \u0633\u0639\u064a\u0643\u0645 \u0644\u0634\u062a\u0649 \" \u064a\u0639\u0646\u064a : \u0633\u0639\u064a \u0623\u0628\u064a \u0628\u0643\u0631 \u0648\u0623\u0645\u064a\u0629 .\u0648\u0631\u0648\u0649 \u0639\u0644\u064a \u0628\u0646 \u062d\u062c\u0631 \u0639\u0646 \u0625\u0633\u062d\u0627\u0642 \u0639\u0646 \u0623\u0628\u064a \u0646\u062c\u064a\u062d \u0639\u0646 \u0639\u0637\u0627\u0621 \u060c \u0642\u0627\u0644 : \u0643\u0627\u0646 \u0644\u0631\u062c\u0644 \u0645\u0646 \u0627\u0644\u0623\u0646\u0635\u0627\u0631 \u0646\u062e\u0644\u0629 \u0648\u0643\u0627\u0646 \u0644\u0647 \u062c\u0627\u0631 \u064a\u0633\u0642\u0637 \u0645\u0646 \u0628\u0644\u062d\u0647\u0627 \u0641\u064a \u062f\u0627\u0631 \u062c\u0627\u0631\u0647 \u060c \u0648\u0643\u0627\u0646 \u0635\u0628\u064a\u0627\u0646\u0647 \u064a\u062a\u0646\u0627\u0648\u0644\u0648\u0646 \u0645\u0646\u0647 \u060c \u0641\u0634\u0643\u0627 \u0630\u0644\u0643 \u0625\u0644\u0649 \u0627\u0644\u0646\u0628\u064a - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u0641\u0642\u0627\u0644 \u0644\u0647 \u0627\u0644\u0646\u0628\u064a - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - : \" \u0628\u0639\u0646\u064a\u0647\u0627 \u0628\u0646\u062e\u0644\u0629 \u0641\u064a \u0627\u0644\u062c\u0646\u0629 \" \u0641\u0623\u0628\u0649 \u060c \u0641\u062e\u0631\u062c \u0641\u0644\u0642\u064a\u0647 \u0623\u0628\u0648 \u0627\u0644\u062f\u062d\u062f\u0627\u062d \u060c \u0641\u0642\u0627\u0644 \u0644\u0647 : \u0647\u0644 \u0644\u0643 \u0623\u0646 \u062a\u0628\u064a\u0639\u0647\u0627 \u0628\u062d\u0634 [ \u0627\u0644\u0628\u0633\u062a\u0627\u0646 ] \u060c \u064a\u0639\u0646\u064a \u062d\u0627\u0626\u0637\u0627 \u0644\u0647 \u060c \u0641\u0642\u0627\u0644 \u0644\u0647 : \u0647\u064a \u0644\u0643 \u060c \u0641\u0623\u062a\u0649 \u0627\u0644\u0646\u0628\u064a - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u0641\u0642\u0627\u0644 : \u064a\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0623\u062a\u0634\u062a\u0631\u064a\u0647\u0627 \u0645\u0646\u064a \u0628\u0646\u062e\u0644\u0629 \u0641\u064a \u0627\u0644\u062c\u0646\u0629 \u061f \u0642\u0627\u0644 : \" \u0646\u0639\u0645 \" \u0642\u0627\u0644 : \u0647\u064a \u0644\u0643 \u060c \u0641\u062f\u0639\u0627 \u200c\u0627\u0644\u0646\u0628\u064a - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u062c\u0627\u0631 \u0627\u0644\u0623\u0646\u0635\u0627\u0631\u064a \u0641\u0642\u0627\u0644 : \" \u062e\u0630\u0647\u0627 \" . \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 : \" \u0648\u0627\u0644\u0644\u064a\u0644 \u0625\u0630\u0627 \u064a\u063a\u0634\u0649 \" \u0625\u0644\u0649 \u0642\u0648\u0644\u0647 : \" \u0625\u0646 \u0633\u0639\u064a\u0643\u0645 \u0644\u0634\u062a\u0649 \" [ \u0633\u0639\u064a \u0623\u0628\u064a ] \u0627\u0644\u062f\u062d\u062f\u0627\u062d \u0648\u0627\u0644\u0623\u0646\u0635\u0627\u0631\u064a \u0635\u0627\u062d\u0628 \u0627\u0644\u0646\u062e\u0644\u0629 .( \u0641\u0623\u0645\u0627 \u0645\u0646 \u0623\u0639\u0637\u0649 \u0648\u0627\u062a\u0642\u0649 ) [ \u064a\u0639\u0646\u064a \u0623\u0628\u0627 ] \u0627\u0644\u062f\u062d\u062f\u0627\u062d \u060c ( \u0648\u0635\u062f\u0642 \u0628\u0627\u0644\u062d\u0633\u0646\u0649 ) [ \u0627\u0644\u062b\u0648\u0627\u0628 ] ( \u0641\u0633\u0646\u064a\u0633\u0631\u0647 \u0644\u0644\u064a\u0633\u0631\u0649 ) \u064a\u0639\u0646\u064a \u0627\u0644\u062c\u0646\u0629 \u060c ( \u0648\u0623\u0645\u0627 \u0645\u0646 \u0628\u062e\u0644 \u0648\u0627\u0633\u062a\u063a\u0646\u0649 ) \u064a\u0639\u0646\u064a \u0627\u0644\u0623\u0646\u0635\u0627\u0631\u064a \u060c ( \u0648\u0643\u0630\u0628 \u0628\u0627\u0644\u062d\u0633\u0646\u0649 ) \u064a\u0639\u0646\u064a \u0627\u0644\u062b\u0648\u0627\u0628 \u060c ( \u0641\u0633\u0646\u064a\u0633\u0631\u0647 \u0644\u0644\u0639\u0633\u0631\u0649 ) \u064a\u0639\u0646\u064a \u0627\u0644\u0646\u0627\u0631 .\n","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6069,"text":"\"\u0648\u0645\u0627 \u064a\u063a\u0646\u064a \u0639\u0646\u0647 \u0645\u0627\u0644\u0647\"\u060c \u0627\u0644\u0630\u064a \u0628\u062e\u0644 \u0628\u0647\u060c \"\u0625\u0630\u0627 \u062a\u0631\u062f\u0649\"\u060c \u0642\u0627\u0644 \u0645\u062c\u0627\u0647\u062f: \u0625\u0630\u0627 \u0645\u0627\u062a. \u0648\u0642\u0627\u0644 \u0642\u062a\u0627\u062f\u0629 \u0648\u0623\u0628\u0648 \u0635\u0627\u0644\u062d: \u0647\u0648\u0649 \u0641\u064a \u062c\u0647\u0646\u0645.\n","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6070,"text":"( \u0625\u0646 \u0639\u0644\u064a\u0646\u0627 \u0644\u0644\u0647\u062f\u0649 ) \u064a\u0639\u0646\u064a \u0627\u0644\u0628\u064a\u0627\u0646 . \u0642\u0627\u0644 \u0627\u0644\u0632\u062c\u0627\u062c : \u0639\u0644\u064a\u0646\u0627 \u0623\u0646 \u0646\u0628\u064a\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0647\u062f\u0649 \u0645\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0636\u0644\u0627\u0644 \u060c \u0648\u0647\u0648 \u0642\u0648\u0644 \u0642\u062a\u0627\u062f\u0629 \u060c \u0642\u0627\u0644 : \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0628\u064a\u0627\u0646 \u062d\u0644\u0627\u0644\u0647 \u0648\u062d\u0631\u0627\u0645\u0647 .\u0642\u0627\u0644 \u0627\u0644\u0641\u0631\u0627\u0621 : \u064a\u0639\u0646\u064a \u0645\u0646 \u0633\u0644\u0643 \u0627\u0644\u0647\u062f\u0649 \u0641\u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0633\u0628\u064a\u0644\u0647 \u0643\u0642\u0648\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 : \" \u0648\u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0642\u0635\u062f \u0627\u0644\u0633\u0628\u064a\u0644 \" ( \u0627\u0644\u0646\u062d\u0644 - 9 ) \u064a\u0642\u0648\u0644 : \u0645\u0646 \u0623\u0631\u0627\u062f \u0627\u0644\u0644\u0647 \u0641\u0647\u0648 \u0639\u0644\u0649 \u0627\u0644\u0633\u0628\u064a\u0644 \u0627\u0644\u0642\u0627\u0635\u062f .\u0648\u0642\u064a\u0644 \u0645\u0639\u0646\u0627\u0647 : \u0625\u0646 \u0639\u0644\u064a\u0646\u0627 \u0644\u0644\u0647\u062f\u0649 \u0648\u0627\u0644\u0625\u0636\u0644\u0627\u0644 \u0643\u0642\u0648\u0644\u0647 : \" \u0628\u064a\u062f\u0643 \u0627\u0644\u062e\u064a\u0631 \" ( \u0622\u0644 \u0639\u0645\u0631\u0627\u0646 - 26 ) [ \u0641\u0627\u0642\u062a\u0635\u0631 \u0639\u0644\u0649 \u0627\u0644\u0647\u062f\u0649 \u0644\u062f\u0644\u0627\u0644\u0629 \u0627\u0644\u0643\u0644\u0627\u0645 \u0639\u0644\u064a\u0647 \u0643\u0642\u0648\u0644\u0647 : \" \u0633\u0631\u0627\u0628\u064a\u0644 \u062a\u0642\u064a\u0643\u0645 \u0627\u0644\u062d\u0631 \" ( \u0627\u0644\u0646\u062d\u0644 - 81 ) \u0641\u0627\u0642\u062a\u0635\u0631 \u0639\u0644\u0649 \u0630\u0643\u0631 \u0627\u0644\u062d\u0631 \u0648\u0644\u0645 \u064a\u0630\u0643\u0631 \u0627\u0644\u0628\u0631\u062f \u0644\u0623\u0646\u0647 \u064a\u062f\u0644 \u0639\u0644\u064a\u0647 ] .\n","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6071,"text":"\"\u0648\u0625\u0646 \u0644\u0646\u0627 \u0644\u0644\u0622\u062e\u0631\u0629 \u0648\u0627\u0644\u0623\u0648\u0644\u0649\"\u060c \u0641\u0645\u0646 \u0637\u0644\u0628\u0647\u0645\u0627 \u0645\u0646 \u063a\u064a\u0631 \u0645\u0627\u0644\u0643\u0647\u0645\u0627 \u0641\u0642\u062f \u0623\u062e\u0637\u0623 \u0627\u0644\u0637\u0631\u064a\u0642.\n","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6072,"text":"\"\u0641\u0623\u0646\u0630\u0631\u062a\u0643\u0645\": \u064a\u0627 \u0623\u0647\u0644 \u0645\u0643\u0629\u060c \"\u0646\u0627\u0631\u0627\u064b \u062a\u0644\u0638\u0649\"\u060c \u0623\u064a: \u062a\u062a\u0644\u0638\u0649\u060c \u064a\u0639\u0646\u064a \u062a\u062a\u0648\u0642\u062f \u0648\u062a\u062a\u0648\u0647\u062c.\n","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6073,"text":"\"\u0644\u0627 \u064a\u0635\u0644\u0627\u0647\u0627 \u0625\u0644\u0627 \u0627\u0644\u0623\u0634\u0642\u0649\".\n","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6074,"text":"\"\u0627\u0644\u0630\u064a \u0643\u0630\u0628\" \u0627\u0644\u0631\u0633\u0648\u0644\u060c \"\u0648\u062a\u0648\u0644\u0649\"\u060c \u0639\u0646 \u0627\u0644\u0625\u064a\u0645\u0627\u0646.\n","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6075,"text":"\"\u0648\u0633\u064a\u062c\u0646\u0628\u0647\u0627 \u0627\u0644\u0623\u062a\u0642\u0649\"\u060c \u064a\u0631\u064a\u062f \u0628\u0627\u0644\u0623\u0634\u0642\u0649 \u0627\u0644\u0634\u0642\u064a\u060c \u0648\u0628\u0627\u0644\u0623\u062a\u0642\u0649 \u0627\u0644\u062a\u0642\u064a.\n","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6076,"text":"( \u0627\u0644\u0630\u064a \u064a\u0624\u062a\u064a \u0645\u0627\u0644\u0647 ) \u064a\u0639\u0637\u064a \u0645\u0627\u0644\u0647 ( \u064a\u062a\u0632\u0643\u0649 ) \u064a\u0637\u0644\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0639\u0646\u062f \u0627\u0644\u0644\u0647 \u0632\u0627\u0643\u064a\u0627 \u0644\u0627 \u0631\u064a\u0627\u0621 \u0648\u0644\u0627 \u0633\u0645\u0639\u0629 \u060c \u064a\u0639\u0646\u064a \u0623\u0628\u0627 \u0628\u0643\u0631 \u0627\u0644\u0635\u062f\u064a\u0642 \u060c \u0641\u064a \u0642\u0648\u0644 \u0627\u0644\u062c\u0645\u064a\u0639 .\u0642\u0627\u0644 \u0627\u0628\u0646 \u0627\u0644\u0632\u0628\u064a\u0631 : \u0643\u0627\u0646 \u0623\u0628\u0648 \u0628\u0643\u0631 \u064a\u0628\u062a\u0627\u0639 \u0627\u0644\u0636\u0639\u0641\u0629 \u0641\u064a\u0639\u062a\u0642\u0647\u0645 \u060c \u0641\u0642\u0627\u0644 \u0623\u0628\u0648\u0647 : \u0623\u064a \u0628\u0646\u064a \u0644\u0648 \u0643\u0646\u062a \u062a\u0628\u062a\u0627\u0639 \u0645\u0646 \u064a\u0645\u0646\u0639 \u0638\u0647\u0631\u0643 \u061f \u0642\u0627\u0644 : \u0645\u0646\u0639 \u0638\u0647\u0631\u064a \u0623\u0631\u064a\u062f \u060c \u0641\u0646\u0632\u0644 : \" \u0648\u0633\u064a\u062c\u0646\u0628\u0647\u0627 \u0627\u0644\u0623\u062a\u0642\u0649 \" \u060c \u0625\u0644\u0649 \u0622\u062e\u0631 \u0627\u0644\u0633\u0648\u0631\u0629 .\u0648\u0630\u0643\u0631 \u0645\u062d\u0645\u062f \u0628\u0646 \u0625\u0633\u062d\u0627\u0642 \u0642\u0627\u0644 : \u0643\u0627\u0646 \u0628\u0644\u0627\u0644 \u0644\u0628\u0639\u0636 \u0628\u0646\u064a \u062c\u0645\u062d \u0648\u0647\u0648 \u0628\u0644\u0627\u0644 \u0628\u0646 \u0631\u0628\u0627\u062d \u0648\u0627\u0633\u0645 \u0623\u0645\u0647 \u062d\u0645\u0627\u0645\u0629 \u060c \u0648\u0643\u0627\u0646 \u0635\u0627\u062f\u0642 \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0637\u0627\u0647\u0631 \u0627\u0644\u0642\u0644\u0628 \u060c \u0648\u0643\u0627\u0646 \u0623\u0645\u064a\u0629 \u0628\u0646 \u062e\u0644\u0641 \u064a\u062e\u0631\u062c\u0647 \u0625\u0630\u0627 \u062d\u0645\u064a\u062a \u0627\u0644\u0638\u0647\u064a\u0631\u0629 \u0641\u064a\u0637\u0631\u062d\u0647 \u0639\u0644\u0649 \u0638\u0647\u0631\u0647 \u0628\u0628\u0637\u062d\u0627\u0621 \u0645\u0643\u0629 \u060c \u062b\u0645 \u064a\u0623\u0645\u0631 \u0628\u0627\u0644\u0635\u062e\u0631\u0629 \u0627\u0644\u0639\u0638\u064a\u0645\u0629 \u0641\u062a\u0648\u0636\u0639 \u0639\u0644\u0649 \u0635\u062f\u0631\u0647 \u060c \u062b\u0645 \u064a\u0642\u0648\u0644 \u0644\u0647 : \u0644\u0627 \u062a\u0632\u0627\u0644 \u0647\u0643\u0630\u0627 \u062d\u062a\u0649 \u062a\u0645\u0648\u062a \u060c \u0623\u0648 \u062a\u0643\u0641\u0631 \u0628\u0645\u062d\u0645\u062f \u060c \u0641\u064a\u0642\u0648\u0644 \u0648\u0647\u0648 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0628\u0644\u0627\u0621 : \u0623\u062d\u062f \u0623\u062d\u062f .\u0648\u0642\u0627\u0644 \u0645\u062d\u0645\u062f \u0628\u0646 \u0625\u0633\u062d\u0627\u0642 \u0639\u0646 \u0647\u0634\u0627\u0645 \u0628\u0646 \u0639\u0631\u0648\u0629 \u0639\u0646 \u0623\u0628\u064a\u0647 \u0642\u0627\u0644 : \u0645\u0631 \u0628\u0647 \u0623\u0628\u0648 \u0628\u0643\u0631 \u064a\u0648\u0645\u0627 \u0648\u0647\u0645 \u064a\u0635\u0646\u0639\u0648\u0646 \u0628\u0647 \u0630\u0644\u0643 \u060c \u0648\u0643\u0627\u0646\u062a \u062f\u0627\u0631 \u0623\u0628\u064a \u0628\u0643\u0631 \u0641\u064a \u0628\u0646\u064a \u062c\u0645\u062d \u060c \u0641\u0642\u0627\u0644 \u0644\u0623\u0645\u064a\u0629 \u0623\u0644\u0627 \u062a\u062a\u0642\u064a \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u0643\u064a\u0646 \u061f \u0642\u0627\u0644 : \u0623\u0646\u062a \u0623\u0641\u0633\u062f\u062a\u0647 \u0641\u0623\u0646\u0642\u0630\u0647 \u0645\u0645\u0627 \u062a\u0631\u0649 \u060c \u0642\u0627\u0644 \u0623\u0628\u0648 \u0628\u0643\u0631 : \u0623\u0641\u0639\u0644! \u0639\u0646\u062f\u064a \u063a\u0644\u0627\u0645 \u0623\u0633\u0648\u062f \u0623\u062c\u0644\u062f \u0645\u0646\u0647 \u0648\u0623\u0642\u0648\u0649 \u060c \u0639\u0644\u0649 \u062f\u064a\u0646\u0643 \u060c \u0623\u0639\u0637\u064a\u0643 \u061f \u0642\u0627\u0644 : \u0642\u062f \u0641\u0639\u0644\u062a \u0641\u0623\u0639\u0637\u0627\u0647 \u0623\u0628\u0648 \u0628\u0643\u0631 \u063a\u0644\u0627\u0645\u0647 \u0648\u0623\u062e\u0630\u0647 \u0641\u0623\u0639\u062a\u0642\u0647 \u060c \u062b\u0645 \u0623\u0639\u062a\u0642 \u0645\u0639\u0647 \u0639\u0644\u0649 \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0642\u0628\u0644 \u0623\u0646 \u064a\u0647\u0627\u062c\u0631 \u0633\u062a [ \u0631\u0642\u0627\u0628 ] \u060c \u0628\u0644\u0627\u0644 \u0633\u0627\u0628\u0639\u0647\u0645 \u060c \u0639\u0627\u0645\u0631 \u0628\u0646 \u0641\u0647\u064a\u0631\u0629 \u0634\u0647\u062f \u0628\u062f\u0631\u0627 \u0648\u0623\u062d\u062f\u0627 \u060c \u0648\u0642\u062a\u0644 \u064a\u0648\u0645 \u0628\u0626\u0631 \u0645\u0639\u0648\u0646\u0629 \u0634\u0647\u064a\u062f\u0627 \u060c \u0648\u0623\u0645 \u0639\u0645\u064a\u0633 \u060c \u0648\u0632\u0646\u064a\u0631\u0629 \u0641\u0623\u0635\u064a\u0628 \u0628\u0635\u0631\u0647\u0627 \u062d\u064a\u0646 \u0623\u0639\u062a\u0642\u0647\u0627 \u060c \u0641\u0642\u0627\u0644\u062a \u0642\u0631\u064a\u0634 : \u0645\u0627 \u0623\u0630\u0647\u0628 \u0628\u0635\u0631\u0647\u0627 \u0625\u0644\u0627 \u0627\u0644\u0644\u0627\u062a \u0648\u0627\u0644\u0639\u0632\u0649 [ \u0641\u0642\u0627\u0644\u062a : \u0643\u0630\u0628\u0648\u0627 \u0648\u0628\u064a\u062a \u0627\u0644\u0644\u0647 \u0645\u0627 \u062a\u0636\u0631 \u0627\u0644\u0644\u0627\u062a \u0648\u0627\u0644\u0639\u0632\u0649 ] \u060c \u0648\u0645\u0627 \u062a\u0646\u0641\u0639\u0627\u0646 \u0641\u0631\u062f \u0627\u0644\u0644\u0647 \u0625\u0644\u064a\u0647\u0627 \u0628\u0635\u0631\u0647\u0627 \u060c \u0648\u0623\u0639\u062a\u0642 \u0627\u0644\u0646\u0647\u062f\u064a\u0629 \u0648\u0627\u0628\u0646\u062a\u0647\u0627 \u060c \u0648\u0643\u0627\u0646\u062a\u0627 \u0644\u0627\u0645\u0631\u0623\u0629 \u0645\u0646 \u0628\u0646\u064a \u0639\u0628\u062f \u0627\u0644\u062f\u0627\u0631 \u0641\u0645\u0631 \u0628\u0647\u0645\u0627 \u0648\u0642\u062f \u0628\u0639\u062b\u062a\u0647\u0645\u0627 \u0633\u064a\u062f\u062a\u0647\u0645\u0627 \u062a\u062d\u0637\u0628\u0627\u0646 \u0644\u0647\u0627 \u0648\u0647\u064a \u062a\u0642\u0648\u0644 \u0648\u0627\u0644\u0644\u0647 \u0644\u0627 \u0623\u0639\u062a\u0642\u0643\u0645\u0627 \u0623\u0628\u062f\u0627 . \u0641\u0642\u0627\u0644 \u0623\u0628\u0648 \u0628\u0643\u0631 : \u062e\u0644\u0627 \u064a\u0627 \u0623\u0645 \u0641\u0644\u0627\u0646 \u060c \u0641\u0642\u0627\u0644\u062a : \u062e\u0644\u0627 \u0623\u0646\u062a \u0623\u0641\u0633\u062f\u062a\u0647\u0645\u0627 \u0641\u0623\u0639\u062a\u0642\u0647\u0645\u0627 \u060c \u0642\u0627\u0644 [ \u0623\u0628\u0648 \u0628\u0643\u0631 - \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 - ] \u0641\u0628\u0643\u0645 \u061f \u0642\u0627\u0644\u062a : \u0628\u0643\u0630\u0627 \u0648\u0643\u0630\u0627 \u060c \u0642\u0627\u0644 : \u0642\u062f \u0623\u062e\u0630\u062a\u0647\u0645\u0627 \u0648\u0647\u0645\u0627 \u062d\u0631\u062a\u0627\u0646 \u060c \u0648\u0645\u0631 \u0628\u062c\u0627\u0631\u064a\u0629 \u0628\u0646\u064a \u0627\u0644\u0645\u0624\u0645\u0644 \u0648\u0647\u064a \u062a\u0639\u0630\u0628 \u0641\u0627\u0628\u062a\u0627\u0639\u0647\u0627 \u0641\u0623\u0639\u062a\u0642\u0647\u0627 .\u0648\u0642\u0627\u0644 \u0633\u0639\u064a\u062f \u0628\u0646 \u0627\u0644\u0645\u0633\u064a\u0628 : \u0628\u0644\u063a\u0646\u064a \u0623\u0646 \u0623\u0645\u064a\u0629 \u0628\u0646 \u062e\u0644\u0641 \u0642\u0627\u0644 \u0644\u0623\u0628\u064a \u0628\u0643\u0631 \u0641\u064a \u0628\u0644\u0627\u0644 \u062d\u064a\u0646 \u0642\u0627\u0644 : \u0623\u062a\u0628\u064a\u0639\u0647 \u061f \u0642\u0627\u0644 : \u0646\u0639\u0645 \u0623\u0628\u064a\u0639\u0647 \u0628\u0646\u0633\u0637\u0627\u0633 \u0639\u0628\u062f \u0644\u0623\u0628\u064a \u0628\u0643\u0631 \u060c \u0635\u0627\u062d\u0628 \u0639\u0634\u0631\u0629 \u0622\u0644\u0627\u0641 \u062f\u064a\u0646\u0627\u0631 \u060c \u0648\u063a\u0644\u0645\u0627\u0646 \u0648\u062c\u0648\u0627\u0631 \u0648\u0645\u0648\u0627\u0634 \u060c \u0648\u0643\u0627\u0646 \u0645\u0634\u0631\u0643\u0627 \u062d\u0645\u0644\u0647 \u0623\u0628\u0648 \u0628\u0643\u0631 \u0639\u0644\u0649 \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0639\u0644\u0649 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0645\u0627\u0644\u0647 \u0644\u0647 \u060c \u0641\u0623\u0628\u0649 \u0641\u0623\u0628\u063a\u0636\u0647 \u0623\u0628\u0648 \u0628\u0643\u0631 \u060c \u0641\u0644\u0645\u0627 \u0642\u0627\u0644 \u0644\u0647 \u0623\u0645\u064a\u0629 \u0623\u0628\u064a\u0639\u0647 \u0628\u063a\u0644\u0627\u0645\u0643 \u0646\u0633\u0637\u0627\u0633 \u0627\u063a\u062a\u0646\u0645