2c\u0652\u0632\u064e\u0649\u0670\u0653","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0628\u0652\u062a\u0650\u063a\u064e\u0627\u0653\u0621\u064e \u0648\u064e\u062c\u0652\u0647\u0650 \u0631\u064e\u0628\u0651\u0650\u0647\u0650 \u0671\u0644\u0652\u0623\u064e\u0639\u0652\u0644\u064e\u0649\u0670","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"\u0648\u064e\u0644\u064e\u0633\u064e\u0648\u0652\u0641\u064e \u064a\u064e\u0631\u0652\u0636\u064e\u0649\u0670","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":92,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0644\u0651\u064e\u064a\u06e1\u0644\u0650","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"By the night when it covers","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6060,"text":"And [by] the day when it appears","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6061,"text":"And [by] He who created the male and female,","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6062,"text":"Indeed, your efforts are diverse.","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6063,"text":"As for he who gives and fears Allah","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6064,"text":"And believes in the best [reward],","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6065,"text":"We will ease him toward ease.","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6066,"text":"But as for he who withholds and considers himself free of need","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6067,"text":"And denies the best [reward],","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6068,"text":"We will ease him toward difficulty.","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6069,"text":"And what will his wealth avail him when he falls?","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6070,"text":"Indeed, [incumbent] upon Us is guidance.","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6071,"text":"And indeed, to Us belongs the Hereafter and the first [life].","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6072,"text":"So I have warned you of a Fire which is blazing.","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6073,"text":"None will [enter to] burn therein except the most wretched one.","numberInSurah":15,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6074,"text":"Who had denied and turned away.","numberInSurah":16,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6075,"text":"But the righteous one will avoid it -","numberInSurah":17,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6076,"text":"[He] who gives [from] his wealth to purify himself","numberInSurah":18,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6077,"text":"And not [giving] for anyone who has [done him] a favor to be rewarded","numberInSurah":19,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6078,"text":"But only seeking the countenance of his Lord, Most High.","numberInSurah":20,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false},{"number":6079,"text":"And he is going to be satisfied.","numberInSurah":21,"juz":30,"manzil":7,"page":596,"ruku":534,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":92,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0644\u0651\u064e\u064a\u06e1\u0644\u0650","englishName":"Al-Lail","englishNameTranslation":"The Night","revelationType":"Meccan","numberOfAyahs":21,"ayahs":[{"number":6059,"text":"\u0623\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0633\u0628\u062d\u0627\u0646\u0647 \u0628\u0627\u0644\u0644\u064a\u0644 \u0639\u0646\u062f\u0645\u0627 \u064a\u063a\u0637\u064a \u0628\u0638\u0644\u0627\u0645\u0647 \u0627\u0644\u0623\u0631\u0636 \u0648\u0645\u0627 \u0639\u0644\u064a\u0647\u0627\u060c \u0648\u0628\u0627\u0644\u0646\u0647\u0627\u0631 \u0625\u0630\u0627 \u0627\u0646\u0643\u0634\u0641 \u0639\u0646 \u0638\u0644\u0627\u0645 \u0627\u0644\u0644\u064a\u0644 \u0628\u0636\u064a\u0627\u0626\u0647\u060c \u0648\u0628\u062e\u0644\u0642 \u0627\u0644\u0632\u0648\u062c\u064a\u0646: \u0627\u0644\u0630\u0643\u0631 \u0648\u0627\u0644\u0623\u0646\u062b\u0649. \u0625\u0646 \u0639\u0645\u0644\u0643\u0645 \u0644\u0645\u062e\u062a\u0644\u0641 \u0628\u064a\u0646 \u0639\u0627\u0645\u0644 \u0644\u0644\u062f\u0646\u064a\u0627 \u0648\u0639\u0627\u0645\u0644 \u0644\u0644\u0622\u062e\u0631\u0629.","numberInSurah":1,