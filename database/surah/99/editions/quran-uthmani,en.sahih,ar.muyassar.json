99,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"And the earth discharges its burdens","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"And man says, \"What is [wrong] with it?\" -","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"That Day, it will report its news","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"Because your Lord has commanded it.","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"That Day, the people will depart separated [into categories] to be shown [the result of] their deeds.","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"So whoever does an atom's weight of good will see it,","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"And whoever does an atom's weight of evil will see it.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":99,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0632\u0651\u064e\u0644\u06e1\u0632\u064e\u0644\u064e\u0629\u0650","englishName":"Az-Zalzala","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"\u0625\u0630\u0627 \u0631\u064f\u062c\u0651\u064e\u062a \u0627\u0644\u0623\u0631\u0636 \u0631\u062c\u0651\u064b\u0627 \u0634\u062f\u064a\u062f\u064b\u0627\u060c \u0648\u0623\u062e\u0631\u062c\u062a \u0645\u0627 \u0641\u064a \u0628\u0637\u0646\u0647\u0627 \u0645\u0646 \u0645\u0648\u062a\u0649 \u0648\u0643