numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0644\u064e\u0642\u064e\u0648\u0652\u0644\u064c\u06ed \u0641\u064e\u0635\u0652\u0644\u064c\u06ed","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"\u0648\u064e\u0645\u064e\u0627 \u0647\u064f\u0648\u064e \u0628\u0650\u0671\u0644\u0652\u0647\u064e\u0632\u0652\u0644\u0650","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"\u0625\u0650\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u064a\u064e\u0643\u0650\u064a\u062f\u064f\u0648\u0646\u064e \u0643\u064e\u064a\u0652\u062f\u064b\u06ed\u0627","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"\u0648\u064e\u0623\u064e\u0643\u0650\u064a\u062f\u064f \u0643\u064e\u064a\u0652\u062f\u064b\u06ed\u0627","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"\u0641\u064e\u0645\u064e\u0647\u0651\u0650\u0644\u0650 \u0671\u0644\u0652\u0643\u064e\u0670\u0641\u0650\u0631\u0650\u064a\u0646\u064e \u0623\u064e\u0645\u0652\u0647\u0650\u0644\u0652\u0647\u064f\u0645\u0652 \u0631\u064f\u0648\u064e\u064a\u0652\u062f\u064b\u06e2\u0627","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":86,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0637\u0651\u064e\u0627\u0631\u0650\u0642\u0650","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"By the sky and the night comer -","numberInSurah":1,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5933,"text":"And what can make you know what is the night comer?","numberInSurah":2,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5934,"text":"It is the piercing star -","numberInSurah":3,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5935,"text":"There is no soul but that it has over it a protector.","numberInSurah":4,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5936,"text":"So let man observe from what he was created.","numberInSurah":5,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5937,"text":"He was created from a fluid, ejected,","numberInSurah":6,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5938,"text":"Emerging from between the backbone and the ribs.","numberInSurah":7,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5939,"text":"Indeed, Allah, to return him [to life], is Able.","numberInSurah":8,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5940,"text":"The Day when secrets will be put on trial,","numberInSurah":9,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5941,"text":"Then man will have no power or any helper.","numberInSurah":10,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5942,"text":"By the sky which returns [rain]","numberInSurah":11,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5943,"text":"And [by] the earth which cracks open,","numberInSurah":12,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5944,"text":"Indeed, the Qur'an is a decisive statement,","numberInSurah":13,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5945,"text":"And it is not amusement.","numberInSurah":14,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5946,"text":"Indeed, they are planning a plan,","numberInSurah":15,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5947,"text":"But I am planning a plan.","numberInSurah":16,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false},{"number":5948,"text":"So allow time for the disbelievers. Leave them awhile.","numberInSurah":17,"juz":30,"manzil":7,"page":591,"ruku":528,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":86,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0637\u0651\u064e\u0627\u0631\u0650\u0642\u0650","englishName":"At-Taariq","englishNameTranslation":"The Morning Star","revelationType":"Meccan","numberOfAyahs":17,"ayahs":[{"number":5932,"text":"\u0623\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0633\u0628\u062d\u0627\u0646\u0647 \u0628\u0627\u0644\u0633\u0645\u0627\u0621 \u0648\u0627\u0644\u0646\u062c\u0645 \u0627\u0644\u0630\u064a \u064a\u0637\u0631\u0642 \u0644\u064a\u0644\u0627 \u0648\u0645\u0627 \u0623\u062f\u0631\u0627\u0643 \u0645\u0627 \u0639\u0650\u0638\u064e\u0645\u064f \u0647\u0630\u0627 \u0627\u0644\u0646\u062c\u0645\u061f \u0647\u0648 \u0627\u0644\u0646\u062c\u0645 \u0627\u0644\u0645\u0636\u064a\u0621 \u0627\u0644\u0645\u062a\u0648\u0647\u0651\u0650\u062c. \u0645\u0627 \u0643\u0644 \u0646\u0641\u0633 \u0625\u0644\u0627 \u0623\u0648\u0643\u0644 \u0628\u0647\u0627 \u0645\u064e\u0644\u064e\u0643 \u0631\u0642\u064a\u0628 \u064a\u062d\u0641\u0638 \u0639\u0644\u064a\u0647\u0627 \u0623\u0639\u0645\u0627\u0644\u0647\u0627 \u0644\u062a\u062d\u0627\u0633\