643\u064e \u0644\u0650\u0645\u064e\u0646\u0652 \u062e\u064e\u0634\u0650\u0649\u064e \u0631\u064e\u0628\u0651\u064e\u0647\u064f\u06e5","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":540,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":98,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0628\u064e\u064a\u0651\u0650\u0646\u064e\u0629\u0650","englishName":"Al-Bayyina","englishNameTranslation":"The Evidence","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6131,"text":"Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief] until there came to them clear evidence -","numberInSurah":1,"juz":30,"manzil":7,"page":598,"ruku":540,"hizbQuarter":239,"sajda":false},{"number":6132,"text":"A Messenger from Allah, reciting purified scriptures","numberInSurah":2,"juz":30,"manzil":7,"page":598,"ruku":540,"hizbQuarter":239,"sajda":false},{"number":6133,"text":"Within which are correct writings.","numberInSurah":3,"juz":30,"manzil":7,"page":598,"ruku":540,"hizbQuarter":239,"sajda":false},{"number":6134,"text":"Nor did those who were given the Scripture become divided until after there had come to them clear evidence.","numberInSurah":4,"juz":30,"manzil":7,"page":598,"ruku":540,"hizbQuarter":239,"sajda":false},{"number":6135,"text":"And they were not commanded except to worship Allah, [being] sincere to Him in religion, inclining to truth, and to establish prayer and to give zakah. And that is the correct religion.","numberInSurah":5,"juz":30,"manzil":7,"page":598,"ruku":540,"hizbQuarter":239,"sajda":false},{"number":6136,"text":"Indeed, they who disbelieved among the People of the Scripture and the polytheists will be in the fire of Hell, abiding eternally therein. Those are the worst of creatures.","numberInSurah":6,"juz":30,"manzil":7,"page":598,"ruku":540,"hizbQuarter":239,"sajda":false},{"number":6137,"text":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","numberInSurah":7,"juz":30,"manzil":7,"page":598,"ruku":540,"hizbQuarter":239,"sajda":false},{"number":6138,"text":"Their reward with Allah will be gardens of perpetual residence beneath which rivers flow, wherein they will abide forever, Allah being pleased with them and they with Him. That is for whoever has feared his Lord.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":540,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":98,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0628\u064e\u064a\u0651\u0650\u0646\u064e\u0629\u0650","englishName":"Al-Bayyina","englishNameTranslation":"The Evidence","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6131,"text":"\u00ab\u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u0630\u064a\u0646 \u0643\u0641\u0631\u0648\u0627 \u0645\u0646\u00bb \u0644\u0644\u0628\u064a\u0627\u0646 \u00ab\u0623\u0647\u0644 \u0627\u0644\u0643\u062a\u0627\u0628 \u0648\u0627\u0644\u0645\u0634\u0631\u0643\u064a\u0646\u00bb \u0623\u064a \u0639\u0628\u062f\u0629 \u0627\u0644\u0623\u0635\u0646\u0627\u0645 \u0639\u0637\u0641 \u0639\u0644\u0649 \u0623\u0647\u0644 \u00ab\u0645\u0646\u0641\u0643\u064a\u0646\u00bb \u062e\u0628\u0631 \u064a\u0643\u0646\u060c \u0623\u064a \u0632\u0627\u0626\u0644\u064a\u0646 \u0639\u0645\u0627 \u0647\u0645 \u0639\u0644\u064a\u0647 \u00ab\u062d\u062a\u0649 \u062a\u0623\u062a\u064a\u0647\u0645\u00bb \u0623\u064a \u0623\u062a\u062a\u0647\u0645 \u00ab\u0627\u0644\u0628\u064a\u0646\u0629\u00bb \u0623\u064a \u0627\u0644\u062d\u062c\