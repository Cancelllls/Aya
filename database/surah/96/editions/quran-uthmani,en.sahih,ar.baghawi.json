{"code":200,"status":"OK","data":[{"number":96,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0639\u064e\u0644\u064e\u0642\u0650","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0671\u0642\u0652\u0631\u064e\u0623\u0652 \u0628\u0650\u0671\u0633\u0652\u0645\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u062e\u064e\u0644\u064e\u0642\u064e","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"\u062e\u064e\u0644\u064e\u0642\u064e \u0671\u0644\u0652\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0645\u0650\u0646\u0652 \u0639\u064e\u0644\u064e\u0642\u064d","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"\u0671\u0642\u0652\u0631\u064e\u0623\u0652 \u0648\u064e\u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0671\u0644\u0652\u0623\u064e\u0643\u0652\u0631\u064e\u0645\u064f","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"\u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u0639\u064e\u0644\u0651\u064e\u0645\u064e \u0628\u0650\u0671\u0644\u0652\u0642\u064e\u0644\u064e\u0645\u0650","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"\u0639\u064e\u0644\u0651\u064e\u0645\u064e \u0671\u0644\u0652\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0645\u064e\u0627 \u0644\u064e\u0645\u0652 \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u0652","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"\u0643\u064e\u0644\u