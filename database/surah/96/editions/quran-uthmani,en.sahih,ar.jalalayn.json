64e\u0631\u0650\u0628 \u06e9","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":96,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0639\u064e\u0644\u064e\u0642\u0650","englishName":"Al-Alaq","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"Recite in the name of your Lord who created -","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"Created man from a clinging substance.","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"Recite, and your Lord is the most Generous -","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"Who taught by the pen -","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"Taught man that which he knew not.","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"No! [But] indeed, man transgresses","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6113,"text":"Because he sees himself self-sufficient.","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6114,"text":"Indeed, to your Lord is the return.","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6115,"text":"Have you seen the one who forbids","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6116,"text":"A servant when he prays?","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6117,"text":"Have you seen if he is upon guidance","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6118,"text":"Or enjoins righteousness?","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6119,"text":"Have you seen if he denies and turns away -","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6120,"text":"Does he not know that Allah sees?","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6121,"text":"No! If he does not desist, We will surely drag him by the forelock -","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6122,"text":"A lying, sinning forelock.","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6123,"text":"Then let him call his associates;","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"We will call the angels of Hell.","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"No! Do not obey him. But prostrate and draw near [to Allah].","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":96,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0639\u064e\u0644\u064e\u0642\u0650","englishName":"Al