9,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5672,"text":"\u0641\u064e\u0628\u0650\u0623\u064e\u0649\u0651\u0650 \u062d\u064e\u062f\u0650\u064a\u062b\u064d\u06ed \u0628\u064e\u0639\u0652\u062f\u064e\u0647\u064f\u06e5 \u064a\u064f\u0624\u0652\u0645\u0650\u0646\u064f\u0648\u0646\u064e","numberInSurah":50,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":77,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064f\u0631\u06e1\u0633\u064e\u0644\u064e\u0627\u062a\u0650","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","revelationType":"Meccan","numberOfAyahs":50,"ayahs":[{"number":5623,"text":"By those [winds] sent forth in gusts","numberInSurah":1,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5624,"text":"And the winds that blow violently","numberInSurah":2,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5625,"text":"And [by] the winds that spread [clouds]","numberInSurah":3,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5626,"text":"And those [angels] who bring criterion","numberInSurah":4,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5627,"text":"And those [angels] who deliver a message","numberInSurah":5,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5628,"text":"As justification or warning,","numberInSurah":6,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5629,"text":"Indeed, what you are promised is to occur.","numberInSurah":7,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5630,"text":"So when the stars are obliterated","numberInSurah":8,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5631,"text":"And when the heaven is opened","numberInSurah":9,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5632,"text":"And when the mountains are blown away","numberInSurah":10,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5633,"text":"And when the messengers' time has come...","numberInSurah":11,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5634,"text":"For what Day was it postponed?","numberInSurah":12,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5635,"text":"For the Day of Judgement.","numberInSurah":13,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5636,"text":"And what can make you know what is the Day of Judgement?","numberInSurah":14,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5637,"text":"Woe, that Day, to the deniers.","numberInSurah":15,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5638,"text":"Did We not destroy the former peoples?","numberInSurah":16,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5639,"text":"Then We will follow them with the later ones.","numberInSurah":17,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5640,"text":"Thus do We deal with the criminals.","numberInSurah":18,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5641,"text":"Woe, that Day, to the deniers.","numberInSurah":19,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5642,"text":"Did We not create you from a liquid disdained?","numberInSurah":20,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5643,"text":"And We placed it in a firm lodging","numberInSurah":21,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5644,"text":"For a known extent.","numberInSurah":22,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5645,"text":"And We determined [it], and excellent [are We] to determine.","numberInSurah":23,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5646,"text":"Woe, that Day, to the deniers.","numberInSurah":24,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5647,"text":"Have We not made the earth a container","numberInSurah":25,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5648,"text":"Of the living and the dead?","numberInSurah":26,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5649,"text":"And We placed therein lofty, firmly set mountains and have given you to drink sweet water.","numberInSurah":27,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5650,"text":"Woe, that Day, to the deniers.","numberInSurah":28,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5651,"text":"[They will be told], \"Proceed to that which you used to deny.","numberInSurah":29,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5652,"text":"Proceed to a shadow [of smoke] having three columns","numberInSurah":30,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5653,"text":"[But having] no cool shade and availing not against the flame.\"","numberInSurah":31,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5654,"text":"Indeed, it throws sparks [as huge] as a fortress,","numberInSurah":32,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5655,"text":"As if they were yellowish [black] camels.","numberInSurah":33,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5656,"text":"Woe, that Day, to the deniers.","numberInSurah":34,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5657,"text":"This is a Day they will not speak,","numberInSurah":35,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5658,"text":"Nor will it be permitted for them to make an excuse.","numberInSurah":36,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5659,"text":"Woe, that Day, to the deniers.","numberInSurah":37,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5660,"text":"This is the Day of Judgement; We will have assembled you and the former peoples.","numberInSurah":38,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5661,"text":"So if you have a plan, then plan against Me.","numberInSurah":39,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5662,"text":"Woe, that Day, to the deniers.","numberInSurah":40,"juz":29,"manzil":7,"page":581,"ruku":516,"hizbQuarter":232,"sajda":false},{"number":5663,"text":"Indeed, the righteous will be among shades and springs","numberInSurah":41,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5664,"text":"And fruits from whatever they desire,","numberInSurah":42,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5665,"text":"[Being told], \"Eat and drink in satisfaction for what you used to do.\"","numberInSurah":43,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5666,"text":"Indeed, We thus reward the doers of good.","numberInSurah":44,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5667,"text":"Woe, that Day, to the deniers.","numberInSurah":45,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5668,"text":"[O disbelievers], eat and enjoy yourselves a little; indeed, you are criminals.","numberInSurah":46,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5669,"text":"Woe, that Day, to the deniers.","numberInSurah":47,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5670,"text":"And when it is said to them, \"Bow [in prayer],\" they do not bow.","numberInSurah":48,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5671,"text":"Woe, that Day, to the deniers.","numberInSurah":49,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false},{"number":5672,"text":"Then in what statement after the Qur'an will they believe?","numberInSurah":50,"juz":29,"manzil":7,"page":581,"ruku":517,"hizbQuarter":232,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":77,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064f\u0631\u06e1\u0633\u064e\u0644\u064e\u0627\u062a\u0650","englishName":"Al-Mursalaat","englishNameTranslation":"The Emissaries","revelationType":"Meccan","numberOfAyahs":50,"ayahs":[{"number":5623,"text":"\u00ab\u0648\u0627\u0644\u0645\u0631\u0633\u0644\u0627\u062a \u0639\u064f\u0631\u0641\u0627\u00bb \u0623\u064a \u0627\u0644\u0631\u064a\u0627\u062d \u0645\u062a\u062a\u0627\u0628\u0639\u0629 \u0643\u0639\u0631\u0641 \u0627\u0644\u0641\u0631\u0633 \u064a\u062a\u0644\u0648 \u0628\u0639\u0636\u0647 \u0628\u0639\u0636\u0627 \u0648\u0646\u0635\u0628\u0647 \u0639\u0644\u0649 \u0627\u0644\u062d\u0627\u0644.","numberInSurah":1,"juz":29,"manzil":7,"page":580,"ruku":516,"hizbQuarter":232,"sajd