":"\u0648\u064e\u0625\u0650\u0644\u064e\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0643\u064e\u064a\u0652\u0641\u064e \u0633\u064f\u0637\u0650\u062d\u064e\u062a\u0652","numberInSurah":20,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5988,"text":"\u0641\u064e\u0630\u064e\u0643\u0651\u0650\u0631\u0652 \u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0645\u064f\u0630\u064e\u0643\u0651\u0650\u0631\u064c\u06ed","numberInSurah":21,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5989,"text":"\u0644\u0651\u064e\u0633\u0652\u062a\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645 \u0628\u0650\u0645\u064f\u0635\u064e\u064a\u0652\u0637\u0650\u0631\u064d","numberInSurah":22,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5990,"text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0645\u064e\u0646 \u062a\u064e\u0648\u064e\u0644\u0651\u064e\u0649\u0670 \u0648\u064e\u0643\u064e\u0641\u064e\u0631\u064e","numberInSurah":23,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5991,"text":"\u0641\u064e\u064a\u064f\u0639\u064e\u0630\u0651\u0650\u0628\u064f\u0647\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0671\u0644\u0652\u0639\u064e\u0630\u064e\u0627\u0628\u064e \u0671\u0644\u0652\u0623\u064e\u0643\u0652\u0628\u064e\u0631\u064e","numberInSurah":24,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5992,"text":"\u0625\u0650\u0646\u0651\u064e \u0625\u0650\u0644\u064e\u064a\u0652\u0646\u064e\u0627\u0653 \u0625\u0650\u064a\u064e\u0627\u0628\u064e\u0647\u064f\u0645\u0652","numberInSurah":25,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5993,"text":"\u062b\u064f\u0645\u0651\u064e \u0625\u0650\u0646\u0651\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0646\u064e\u0627 \u062d\u0650\u0633\u064e\u0627\u0628\u064e\u0647\u064f\u0645","numberInSurah":26,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":88,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u063a\u064e\u0627\u0634\u0650\u064a\u064e\u0629\u0650","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","numberOfAyahs":26,"ayahs":[{"number":5968,"text":"Has there reached you the report of the Overwhelming [event]?","numberInSurah":1,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5969,"text":"[Some] faces, that Day, will be humbled,","numberInSurah":2,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5970,"text":"Working [hard] and exhausted.","numberInSurah":3,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5971,"text":"They will [enter to] burn in an intensely hot Fire.","numberInSurah":4,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5972,"text":"They will be given drink from a boiling spring.","numberInSurah":5,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5973,"text":"For them there will be no food except from a poisonous, thorny plant","numberInSurah":6,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5974,"text":"Which neither nourishes nor avails against hunger.","numberInSurah":7,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5975,"text":"[Other] faces, that Day, will show pleasure.","numberInSurah":8,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5976,"text":"With their effort [they are] satisfied","numberInSurah":9,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5977,"text":"In an elevated garden,","numberInSurah":10,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5978,"text":"Wherein they will hear no unsuitable speech.","numberInSurah":11,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5979,"text":"Within it is a flowing spring.","numberInSurah":12,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5980,"text":"Within it are couches raised high","numberInSurah":13,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5981,"text":"And cups put in place","numberInSurah":14,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5982,"text":"And cushions lined up","numberInSurah":15,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5983,"text":"And carpets spread around.","numberInSurah":16,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5984,"text":"Then do they not look at the camels - how they are created?","numberInSurah":17,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5985,"text":"And at the sky - how it is raised?","numberInSurah":18,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5986,"text":"And at the mountains - how they are erected?","numberInSurah":19,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5987,"text":"And at the earth - how it is spread out?","numberInSurah":20,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5988,"text":"So remind, [O Muhammad]; you are only a reminder.","numberInSurah":21,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5989,"text":"You are not over them a controller.","numberInSurah":22,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5990,"text":"However, he who turns away and disbelieves -","numberInSurah":23,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5991,"text":"Then Allah will punish him with the greatest punishment.","numberInSurah":24,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5992,"text":"Indeed, to Us is their return.","numberInSurah":25,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5993,"text":"Then indeed, upon Us is their account.","numberInSurah":26,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":88,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u063a\u064e\u0627\u0634\u0650\u064a\u064e\u0629\u0650","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","numberOfAyahs":26,"ayahs":[{"number":5968,"text":"\u0647\u0644 \u0623\u062a\u0627\u0643 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0631\u0633\u0648\u0644- \u062e\u0628\u0631 \u0627\u0644\u0642\u064a\u0627\u0645\u0629 \u0627\u0644\u062a\u064a \u062a\u063a\u0634\u0649 \u0627\u0644\u0646\u0627\u0633 \u0628\u0623\u0647\u0648\u0627\u0644\u0647\u0627\u061f","numberInSurah":1,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5969,"text":"\u0648\u062c\u0648\u0647 \u0627\u0644\u0643\u0641\u0627\u0631 \u064a\u0648\u0645\u0626\u0630 \u0630\u0644\u064a\u0644\u0629 \u0628\u0627\u0644\u0639\u0630\u0627\u0628\u060c \u0645\u062c\u0647\u062f\u0629 \u0628\u0627\u0644\u0639\u0645\u0644 \u0645\u062a\u0639\u0628\u0629\u060c \u062a\u0635\u064a\u0628\u0647\u0627 \u0646\u0627\u0631 \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u0648\u0647\u062c\u060c \u062a\u064f\u0633\u0642\u0649 \u0645\u0646 \u0639\u064a\u0646 \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u0629. \u0644\u064a\u0633 \u0644\u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0646\u0627\u0631 \u0637\u0639\u0627\u0645 \u0625\u0644\u0627 \u0645\u0646 \u0646\u0628\u062a \u0630\u064a \u0634\u0648\u0643 \u0644\u0627\u0635\u0642 \u0628\u0627\u0644\u0623\u0631\u0636\u060c \u0648\u0647\u0648 \u0645\u0650\u0646 \u0634\u0631 \u0627\u0644\u0637\u0639\u0627\u0645 \u0648\u0623\u062e\u0628\u062b\u0647\u060c \u0644\u0627 \u064a\u064f\u0633\u0652\u0645\u0646 \u0628\u062f\u0646 \u0635\u0627\u062d\u0628\u0647 \u0645\u0646 \u0627\u0644\u0647\u064f\u0632\u0627\u0644\u060c \u0648\u0644\u0627 \u064a\u0633\u062f\u0651\u064f \u062c\u0648\u0639\u0647 \u0648\u0631\u0645\u0642\u0647.","numberInSurah":2,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5970,"text":"\u0648\u062c\u0648\u0647 \u0627\u0644\u0643\u0641\u0627\u0631 \u064a\u0648\u0645\u0626\u0630 \u0630\u0644\u064a\u0644\u0629 \u0628\u0627\u0644\u0639\u0630\u0627\u0628\u060c \u0645\u062c\u0647\u062f\u0629 \u0628\u0627\u0644\u0639\u0645\u0644 \u0645\u062a\u0639\u0628\u0629\u060c \u062a\u0635\u064a\u0628\u0647\u0627 \u0646\u0627\u0631 \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u0648\u0647\u062c\u060c \u062a\u064f\u0633\u0642\u0649 \u0645\u0646 \u0639\u064a\u0646 \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u0629. \u0644\u064a\u0633 \u0644\u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0646\u0627\u0631 \u0637\u0639\u0627\u0645 \u0625\u0644\u0627 \u0645\u0646 \u0646\u0628\u062a \u0630\u064a \u0634\u0648\u0643 \u0644\u0627\u0635\u0642 \u0628\u0627\u0644\u0623\u0631\u0636\u060c \u0648\u0647\u0648 \u0645\u0650\u0646 \u0634\u0631 \u0627\u0644\u0637\u0639\u0627\u0645 \u0648\u0623\u062e\u0628\u062b\u0647\u060c \u0644\u0627 \u064a\u064f\u0633\u0652\u0645\u0646 \u0628\u062f\u0646 \u0635\u0627\u062d\u0628\u0647 \u0645\u0646 \u0627\u0644\u0647\u064f\u0632\u0627\u0644\u060c \u0648\u0644\u0627 \u064a\u0633\u062f\u0651\u064f \u062c\u0648\u0639\u0647 \u0648\u0631\u0645\u0642\u0647.","numberInSurah":3,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5971,"text":"\u0648\u062c\u0648\u0647 \u0627\u0644\u0643\u0641\u0627\u0631 \u064a\u0648\u0645\u0626\u0630 \u0630\u0644\u064a\u0644\u0629 \u0628\u0627\u0644\u0639\u0630\u0627\u0628\u060c \u0645\u062c\u0647\u062f\u0629 \u0628\u0627\u0644\u0639\u0645\u0644 \u0645\u062a\u0639\u0628\u0629\u060c \u062a\u0635\u064a\u0628\u0647\u0627 \u0646\u0627\u0631 \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u0648\u0647\u062c\u060c \u062a\u064f\u0633\u0642\u0649 \u0645\u0646 \u0639\u064a\u0646 \u0634\u062f\u064a\u062f\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u0629. \u0644\u064a\u0633 \u0644\u0623\u0635\u062d\u0627\u0628 \u0627\u0644\u0646\u0627\u0631 \u0637\u0639\u0627\u0645 \u0625\u0644\u0627 \u0645\u0646 \u0646\u0628\u062a \u0630\u064a \u0634\u0648\u0643 \u0644\u0627\u0635\u0642 \u0628\u0627\u0644\u0623\u0631\u0636\u060c \u0648\u0647\u0648 \u0645\u0650\u0646 \u0634\u0631 \u0627\u0644\u0637\u0639\u0627\u0645 \u0648\u0623\u062e\u0628\u062b\u0647\u060c \u0644\u0627 \u064a\u064f\u0633\u0652\u0645\u0646 \u0628\u062f\u0646 \u0635\u0627\u062d\u0628\u0647 \u0645\u0646 \u0627\u0644\u0647\u064f\u0632\u0627\u0644\u060c \u0648\u0644\u0627 \u064a\u0633\u062f\u0651\u064f \u062c\u0648\u0639\u0647 \u0648\u0631\u0645\u0642\u0647.","numberInSurah":4,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5972,"text":"\u0648\u062c\u0648\u0647 \u0627\u0644\u0643\u0641\u0627\u0631 \u064a\u0648\u0645\u0626\u0630 \u0630\u0644\u064a\u0644\u0629 \u0628\u0627\u0644\u0639\u0630\u0627\u0628\u060c \u0645\u062c\u0647\u062f\u0629 \u0628\u0627\u0644\u0639\u0645\u0644 \u0645\u062a\u0639\u0628\u0629\u060c \u062a\u0635\u064a\u0628\u0647\u0627 \u0646\u0627\u0631 \u0634