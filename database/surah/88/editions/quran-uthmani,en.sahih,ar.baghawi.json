{"code":200,"status":"OK","data":[{"number":88,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u063a\u064e\u0627\u0634\u0650\u064a\u064e\u0629\u0650","englishName":"Al-Ghaashiya","englishNameTranslation":"The Overwhelming","revelationType":"Meccan","numberOfAyahs":26,"ayahs":[{"number":5968,"text":"\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0647\u064e\u0644\u0652 \u0623\u064e\u062a\u064e\u0649\u0670\u0643\u064e \u062d\u064e\u062f\u0650\u064a\u062b\u064f \u0671\u0644\u0652\u063a\u064e\u0670\u0634\u0650\u064a\u064e\u0629\u0650","numberInSurah":1,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5969,"text":"\u0648\u064f\u062c\u064f\u0648\u0647\u064c\u06ed \u064a\u064e\u0648\u0652\u0645\u064e\u0626\u0650\u0630\u064d \u062e\u064e\u0670\u0634\u0650\u0639\u064e\u0629\u064c","numberInSurah":2,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5970,"text":"\u0639\u064e\u0627\u0645\u0650\u0644\u064e\u0629\u064c\u06ed \u0646\u0651\u064e\u0627\u0635\u0650\u0628\u064e\u0629\u064c\u06ed","numberInSurah":3,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5971,"text":"\u062a\u064e\u0635\u0652\u0644\u064e\u0649\u0670 \u0646\u064e\u0627\u0631\u064b\u0627 \u062d\u064e\u0627\u0645\u0650\u064a\u064e\u0629\u064b\u06ed","numberInSurah":4,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5972,"text":"\u062a\u064f\u0633\u0652\u0642\u064e\u0649\u0670 \u0645\u0650\u0646\u0652 \u0639\u064e\u064a\u0652\u0646\u064d \u0621\u064e\u0627\u0646\u0650\u064a\u064e\u0629\u064d\u06e2","numberInSurah":5,"juz":30,"manzil":7,"page":592,"ruku":530,"hizbQuarter":237,"sajda":false},{"number":5973,"text":"\u0644\u0651\u064e\u064a\u0652\u0633\u064e \u0644\u064e\u0647\u064f\u0645\u0652 \u0