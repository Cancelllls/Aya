u0650 \u0646\u064e\u0627\u0642\u064e\u0629\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0633\u064f\u0642\u0652\u064a\u064e\u0670\u0647\u064e\u0627","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"\u0641\u064e\u0643\u064e\u0630\u0651\u064e\u0628\u064f\u0648\u0647\u064f \u0641\u064e\u0639\u064e\u0642\u064e\u0631\u064f\u0648\u0647\u064e\u0627 \u0641\u064e\u062f\u064e\u0645\u0652\u062f\u064e\u0645\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0631\u064e\u0628\u0651\u064f\u0647\u064f\u0645 \u0628\u0650\u0630\u064e\u0646\u06e2\u0628\u0650\u0647\u0650\u0645\u0652 \u0641\u064e\u0633\u064e\u0648\u0651\u064e\u0649\u0670\u0647\u064e\u0627","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u062e\u064e\u0627\u0641\u064f \u0639\u064f\u0642\u0652\u0628\u064e\u0670\u0647\u064e\u0627","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":91,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0634\u0651\u064e\u0645\u06e1\u0633\u0650","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"By the sun and its brightness","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6045,"text":"And [by] the moon when it follows it","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6046,"text":"And [by] the day when it displays it","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6047,"text":"And [by] the night when it covers it","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6048,"text":"And [by] the sky and He who constructed it","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6049,"text":"And [by] the earth and He who spread it","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6050,"text":"And [by] the soul and He who proportioned it","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6051,"text":"And inspired it [with discernment of] its wickedness and its righteousness,","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6052,"text":"He has succeeded who purifies it,","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6053,"text":"And he has failed who instills it [with corruption].","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6054,"text":"Thamud denied [their prophet] by reason of their transgression,","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6055,"text":"When the most wretched of them was sent forth.","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6056,"text":"And the messenger of Allah [Salih] said to them, \"[Do not harm] the she-camel of Allah or [prevent her from] her drink.\"","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"And He does not fear the consequence thereof.","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":91,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0634\u0651\u064e\u0645\u06e1\u0633\u0650","englishName":"Ash-Shams","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"\u0623\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0628\u0627\u0644\u0634\u0645\u0633 \u0648\u0646\u0647\u0627\u0631\u0647\u0627 \u0648\u0625\u0634\u0631\u0627\u0642\u0647\u0627 \u0636\u062d\u0649\u060c \u0648\u0628\u0627\u0644\u0642\u0645\u0631 \u0625\u0630\u0627 \u062a\u0628\u0639\u0647\u0627 \u0641\u064a \u0627\u0644\u0637\u0644\u0648\u0639 \u0648\u0627\u0644\u0623\u0641\u0648\u0644\u060c \u0648\u0628\u0627\u0644\u0646\u0647\u0627\u0631 \u0625\u0630\u0627 \u062c\u0644\u0651\u064e\u0649 \u0627\u0644\u0638\u0644\u0645\u0629 \u0648\u0643\u0634\u0641\u0647\u0627\u060c \u0648\u0628\u0627\u0644\u0644\u064a\u0644 \u0639\u0646\u062f\u0645\u0627 \u064a\u063a\u0637\u064a \u0627\u0644\u0623\u0631\u0636 \u0641\u064a\u0643\u0648\u0646 \u0645\u0627 \u0639\u0644\u064a\u0647\u0627 \u0645\u0638\u0644\u0645\u064b\u0627\u060c \u0648\u0628\u0627\u0644\u0633\u0645\u0627\u0621 \u0648\u0628\u0646\u0627\u0626\u0647\u0627 \u0627\u0644\u0645\u062d\u0643\u0645\u060c \u0648\u0628\u0627\u0644\u0623\u0631\u0636 \u0648\u0628\u064e\u0633\u0652\u0637\u0647\u0627\u060c \u0648\u0628\u0643\u0644 \u0646\u0641\u0633 \u0648\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0644\u0647 \u062e\u0644\u0642\u0647\u0627 \u0644\u0623\u062f\u0627\u0621 \u0645\u0647\u0645\u062a\u0647\u0627\u060c \u0641\u0628\u064a\u0651\u064e\u0646 \u0644\u0647\u0627 \u