\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0645\u064f\u0646\u062a\u064e\u0647\u064e\u0649\u0670\u0647\u064e\u0627\u0653","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5757,"text":"\u0625\u0650\u0646\u0651\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064e \u0645\u064f\u0646\u0630\u0650\u0631\u064f \u0645\u064e\u0646 \u064a\u064e\u062e\u0652\u0634\u064e\u0649\u0670\u0647\u064e\u0627","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5758,"text":"\u0643\u064e\u0623\u064e\u0646\u0651\u064e\u0647\u064f\u0645\u0652 \u064a\u064e\u0648\u0652\u0645\u064e \u064a\u064e\u0631\u064e\u0648\u0652\u0646\u064e\u0647\u064e\u0627 \u0644\u064e\u0645\u0652 \u064a\u064e\u0644\u0652\u0628\u064e\u062b\u064f\u0648\u0653\u0627\u06df \u0625\u0650\u0644\u0651\u064e\u0627 \u0639\u064e\u0634\u0650\u064a\u0651\u064e\u0629\u064b \u0623\u064e\u0648\u0652 \u0636\u064f\u062d\u064e\u0649\u0670\u0647\u064e\u0627","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":79,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0646\u0651\u064e\u0627\u0632\u0650\u0639\u064e\u0627\u062a\u0650","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"By those [angels] who extract with violence","numberInSurah":1,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5714,"text":"And [by] those who remove with ease","numberInSurah":2,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5715,"text":"And [by] those who glide [as if] swimming","numberInSurah":3,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5716,"text":"And those who race each other in a race","numberInSurah":4,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5717,"text":"And those who arrange [each] matter,","numberInSurah":5,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5718,"text":"On the Day the blast [of the Horn] will convulse [creation],","numberInSurah":6,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5719,"text":"There will follow it the subsequent [one].","numberInSurah":7,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5720,"text":"Hearts, that Day, will tremble,","numberInSurah":8,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5721,"text":"Their eyes humbled.","numberInSurah":9,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5722,"text":"They are [presently] saying, \"Will we indeed be returned to [our] former state [of life]?","numberInSurah":10,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5723,"text":"Even if we should be decayed bones?","numberInSurah":11,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5724,"text":"They say, \"That, then, would be a losing return.\"","numberInSurah":12,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5725,"text":"Indeed, it will be but one shout,","numberInSurah":13,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5726,"text":"And suddenly they will be [alert] upon the earth's surface.","numberInSurah":14,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5727,"text":"Has there reached you the story of Moses? -","numberInSurah":15,"juz":30,"manzil":7,"page":583,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5728,"text":"When his Lord called to him in the sacred valley of Tuwa,","numberInSurah":16,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5729,"text":"\"Go to Pharaoh. Indeed, he has transgressed.","numberInSurah":17,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5730,"text":"And say to him, 'Would you [be willing to] purify yourself","numberInSurah":18,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5731,"text":"And let me guide you to your Lord so you would fear [Him]?'\"","numberInSurah":19,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5732,"text":"And he showed him the greatest sign,","numberInSurah":20,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5733,"text":"But Pharaoh denied and disobeyed.","numberInSurah":21,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5734,"text":"Then he turned his back, striving.","numberInSurah":22,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5735,"text":"And he gathered [his people] and called out","numberInSurah":23,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5736,"text":"And said, \"I am your most exalted lord.\"","numberInSurah":24,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5737,"text":"So Allah seized him in exemplary punishment for the last and the first [transgression].","numberInSurah":25,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5738,"text":"Indeed in that is a warning for whoever would fear [Allah].","numberInSurah":26,"juz":30,"manzil":7,"page":584,"ruku":520,"hizbQuarter":233,"sajda":false},{"number":5739,"text":"Are you a more difficult creation or is the heaven? Allah constructed it.","numberInSurah":27,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5740,"text":"He raised its ceiling and proportioned it.","numberInSurah":28,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5741,"text":"And He darkened its night and extracted its brightness.","numberInSurah":29,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5742,"text":"And after that He spread the earth.","numberInSurah":30,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5743,"text":"He extracted from it its water and its pasture,","numberInSurah":31,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5744,"text":"And the mountains He set firmly","numberInSurah":32,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5745,"text":"As provision for you and your grazing livestock.","numberInSurah":33,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5746,"text":"But when there comes the greatest Overwhelming Calamity -","numberInSurah":34,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5747,"text":"The Day when man will remember that for which he strove,","numberInSurah":35,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5748,"text":"And Hellfire will be exposed for [all] those who see -","numberInSurah":36,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5749,"text":"So as for he who transgressed","numberInSurah":37,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5750,"text":"And preferred the life of the world,","numberInSurah":38,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5751,"text":"Then indeed, Hellfire will be [his] refuge.","numberInSurah":39,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5752,"text":"But as for he who feared the position of his Lord and prevented the soul from [unlawful] inclination,","numberInSurah":40,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5753,"text":"Then indeed, Paradise will be [his] refuge.","numberInSurah":41,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5754,"text":"They ask you, [O Muhammad], about the Hour: when is its arrival?","numberInSurah":42,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5755,"text":"In what [position] are you that you should mention it?","numberInSurah":43,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5756,"text":"To your Lord is its finality.","numberInSurah":44,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5757,"text":"You are only a warner for those who fear it.","numberInSurah":45,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false},{"number":5758,"text":"It will be, on the Day they see it, as though they had not remained [in the world] except for an afternoon or a morning thereof.","numberInSurah":46,"juz":30,"manzil":7,"page":584,"ruku":521,"hizbQuarter":233,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":79,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0646\u0651\u064e\u0627\u0632\u0650\u0639\u064e\u0627\u062a\u0650","englishName":"An-Naazi'aat","englishNameTranslation":"Those who drag forth","revelationType":"Meccan","numberOfAyahs":46,"ayahs":[{"number":5713,"text":"\u00ab\u0648\u0627\u0644\u0646\u0627\u0632\u0639\u0627\u062a\u00bb \u062