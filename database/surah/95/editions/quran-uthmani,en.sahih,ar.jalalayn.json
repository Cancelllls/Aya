7,"hizbQuarter":239,"sajda":false},{"number":6101,"text":"And [by] this secure city [Makkah],","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6102,"text":"We have certainly created man in the best of stature;","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6103,"text":"Then We return him to the lowest of the low,","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6104,"text":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6105,"text":"So what yet causes you to deny the Recompense?","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6106,"text":"Is not Allah the most just of judges?","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":95,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u062a\u0651\u0650\u064a\u0646\u0650","englishName":"At-Tin","englishNameTranslation":"The Fig","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6099,"text":"\u00ab\u0648\u0627\u0644\u062a\u064a\u0646 \u0648\u0627\u0644\u0632\u064a\u062a\u0648\u0646\u00bb \u0623\u064a \u0627\u0644\u0645\u0623\u0643\u0648\u0644\u064a\u0646 \u0623\u0648 \u062c\u0628\u0644\u064a\u0646 \u0628\u0627\u0644\u0634\u0627\u0645 \u064a\u0646\u0628\u062a\u0627\u0646 \u0627\u0644\u0645\u0623\u0643\u0648\u0644\u064a\u0646.","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":537,"hizbQuarter":239,"sajda":false},{"number":6100,"text":"\u00ab\u0648\u0637\u0648\u0631 \u0633\u064a\u0646\u064a\u0646\u00b