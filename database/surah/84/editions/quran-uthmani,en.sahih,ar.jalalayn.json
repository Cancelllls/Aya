28\u064d \u0623\u064e\u0644\u0650\u064a\u0645\u064d","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u06df \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0644\u064e\u0647\u064f\u0645\u0652 \u0623\u064e\u062c\u0652\u0631\u064c \u063a\u064e\u064a\u0652\u0631\u064f \u0645\u064e\u0645\u0652\u0646\u064f\u0648\u0646\u064d\u06ed","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":84,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0627\u0646\u0634\u0650\u0642\u064e\u0627\u0642\u0650","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"When the sky has split [open]","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"And has responded to its Lord and was obligated [to do so]","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5887,"text":"And when the earth has been extended","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5888,"text":"And has cast out that within it and relinquished [it]","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5889,"text":"And has responded to its Lord and was obligated [to do so] -","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5890,"text":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5891,"text":"Then as for he who is given his record in his right hand,","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5892,"text":"He will be judged with an easy account","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5893,"text":"And return to his people in happiness.","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5894,"text":"But as for he who is given his record behind his back,","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5895,"text":"He will cry out for destruction","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5896,"text":"And [enter to] burn in a Blaze.","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5897,"text":"Indeed, he had [once] been among his people in happiness;","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5898,"text":"Indeed, he had thought he would never return [to Allah].","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5899,"text":"But yes! Indeed, his Lord was ever of him, Seeing.","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5900,"text":"So I swear by the twilight glow","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5901,"text":"And [by] the night and what it envelops","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5902,"text":"And [by] the moon when it becomes full","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5903,"text":"[That] you will surely experience state after state.","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5904,"text":"So what is [the matter] with them [that] they do not believe,","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5905,"text":"And when the Qur'an is recited to them, they do not prostrate [to Allah]?","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false}},{"number":5906,"text":"But those who have disbelieved deny,","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5907,"text":"And Allah is most knowing of what they keep within themselves.","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5908,"text":"So give them tidings of a painful punishment,","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"Except for those who believe and do righteous deeds. For them is a reward uninterrupted.","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":84,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0627\u0646\u0634\u0650\u0642\u064e\u0627\u0642\u0650","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"aya