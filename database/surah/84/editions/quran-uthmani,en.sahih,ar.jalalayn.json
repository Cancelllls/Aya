{"code":200,"status":"OK","data":[{"number":84,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0627\u0646\u0634\u0650\u0642\u064e\u0627\u0642\u0650","englishName":"Al-Inshiqaaq","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0653\u0621\u064f \u0671\u0646\u0634\u064e\u0642\u0651\u064e\u062a\u0652","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"\u0648\u064e\u0623\u064e\u0630\u0650\u0646\u064e\u062a\u0652 \u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u064e\u0627 \u0648\u064e\u062d\u064f\u0642\u0651\u064e\u062a\u0652","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5887,"text":"\u0648\u064e\u0625\u0650\u0630\u064e\u0627 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u064f \u0645\u064f\u062f\u0651\u064e\u062a\u0652","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5888,"text":"\u0648\u064e\u0623\u064e\u0644\u0652\u0642\u064e\u062a\u0652 \u0645\u064e\u0627 \u0641\u0650\u064a\u0647\u064e\u0627 \u0648\u064e\u062a\u064e\u062e\u064e\u0644\u0651\u064e\u062a\u0652","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5889,"text":"\u0648\u064e\u0623\u064e\u0630\u0650\u0646\u064e\u062a\u0652 \u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0647\u064e\u0627 \u0648\u064e\u062d\u064f\u0642\u0651\u064e\u062a\u0652","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5890,"text":"\u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u0