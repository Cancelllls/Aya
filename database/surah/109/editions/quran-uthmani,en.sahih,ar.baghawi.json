juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6213,"text":"\u0644\u064e\u0643\u064f\u0645\u0652 \u062f\u0650\u064a\u0646\u064f\u0643\u064f\u0645\u0652 \u0648\u064e\u0644\u0650\u0649\u064e \u062f\u0650\u064a\u0646\u0650","numberInSurah":6,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":109,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0643\u064e\u0627\u0641\u0650\u0631\u064f\u0648\u0646\u064e","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6208,"text":"Say, \"O disbelievers,","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6209,"text":"I do not worship what you worship.","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6210,"text":"Nor are you worshippers of what I worship.","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6211,"text":"Nor will I be a worshipper of what you worship.","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6212,"text":"Nor will you be worshippers of what I worship.","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6213,"text":"For you is your religion, and for me is my religion.\"","numberInSurah":6,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":109,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0643\u064e\u0627\u0641\u0650\u0631\u064f\u0648\u0646\u064e","englishName":"Al-Kaafiroon","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6208,"text":"\u0645\u0643\u064a\u0629( \u0642\u0644 \u064a\u0627 \u0623\u064a\u0647\u0627 \u0627\u0644\u0643\u0627\u0641\u0631\u0648\u0646 ) \u0625\u0644\u0649 \u0622\u062e\u0631 \u0627\u0644\u0633\u0648\u0631\u0629 .\u0646\u0632\u0644\u062a \u0641\u064a \u0631\u0647\u0637 \u0645\u0646 \u0642\u0631\u064a\u0634 \u0645\u0646\u0647\u0645 : \u0627\u0644\u062d\u0627\u0631\u062b \u0628\u0646 \u0642\u064a\u0633 \u0627\u0644\u0633\u0647\u0645\u064a \u060c \u0648\u0627\u0644\u0639\u0627\u0635 \u0628\u0646 \u0648\u0627\u0626\u0644 \u060c \u0648\u0627\u0644\u0648\u0644\u064a\u062f \u0628\u0646 \u0627\u0644\u0645\u063a\u064a\u0631\u0629 \u060c [ \u0648\u0627\u0644\u0623\u0633\u0648\u062f ] \u0628\u0646 \u0639\u0628\u062f \u064a\u063a\u0648\u062b \u060c \u0648\u0627\u0644\u0623\u0633\u0648\u062f \u0628\u0646 \u0627\u0644\u0645\u0637\u0644\u0628 \u0628\u0646 \u0623\u0633\u062f \u060c \u0648\u0623\u0645\u064a\u0629 \u0628\u0646 \u062e\u0644\u0641 \u060c \u0642\u0627\u0644\u0648\u0627 : \u064a\u0627 \u0645\u062d\u0645\u062f [ \u0647\u0644\u0645 \u0641\u0627\u062a\u0628\u0639 ] \u062f\u064a\u0646\u0646\u0627 \u0648\u0646\u062a\u0628\u0639 \u062f\u064a\u0646\u0643 \u0648\u0646\u0634\u0631\u0643\u0643 \u0641\u064a \u0623\u0645\u0631\u0646\u0627 \u0643\u0644\u0647 \u060c \u062a\u0639\u0628\u062f \u0622\u0644\u0647\u062a\u0646\u0627 \u0633\u0646\u0629 \u0648\u0646\u0639\u0628\u062f \u0625\u0644\u0647\u0643 \u0633\u0646\u0629 \u060c \u0641\u0625\u0646 \u0643\u0627\u0646 \u0627\u0644\u0630\u064a \u062c\u0626\u062a \u0628\u0647 \u062e\u064a\u0631\u0627 \u0643\u0646\u0627 \u0642\u062f \u0634\u0631\u0643\u0646\u0627\u0643 \u0641\u064a\u0647 \u0648\u0623\u062e\u0630\u0646\u0627 \u062d\u0638\u0646\u0627 \u0645\u0646\u0647 \u060c \u0648\u0625\u0646 \u0643\u0627\u0646 \u0627\u0644\u0630\u064a \u0628\u0623\u064a\u062f\u064a\u0646\u0627 \u062e\u064a\u0631\u0627 \u0643\u0646\u062a \u0642\u062f \u0634\u0631\u0643\u062a\u0646\u0627 \u0641\u064a \u0623\u0645\u0631\u0646\u0627 \u0648\u0623\u062e\u0630\u062a \u0628\u062d\u0638\u0643 \u0645\u0646\u0647 \u060c \u0641\u0642\u0627\u0644 : \u0645\u0639\u0627\u0630 \u0627\u0644\u0644\u0647 \u0623\u0646 \u0623\u0634\u0631\u0643 \u0628\u0647 \u063a\u064a\u0631\u0647 \u060c \u0642\u0627\u0644\u0648\u0627 : \u0641\u0627\u0633\u062a\u0644\u0645 \u0628\u0639\u0636 \u0622\u0644\u0647\u062a\u0646\u0627 \u0646\u0635\u062f\u0642\u0643 \u0648\u0646\u0639\u0628\u062f \u0625\u0644\u0647\u0643 \u060c \u0641\u0642\u0627\u0644 : \u062d\u062a\u0649 \u0623\u0646\u0638\u0631 \u0645\u0627 \u064a\u0623\u062a\u064a \u0645\u0646 \u0639\u0646\u062f \u0631\u0628\u064a \u060c \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 - \u0639\u0632 \u0648\u062c\u0644 - : \" \u0642\u0644 \u064a\u0627 \u0623\u064a\u0647\u0627 \u0627\u0644\u0643\u0627\u0641\u0631\u0648\u0646 \" \u0625\u0644\u0649 \u0622\u062e\u0631 \u0627\u0644\u0633\u0648\u0631\u0629 \u060c \u0641\u063a\u062f\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062c\u062f \u0627\u0644\u062d\u0631\u0627\u0645 \u0648\u0641\u064a\u0647 \u0627\u0644\u0645\u0644\u0623 \u0645\u0646 \u0642\u0631\u064a\u0634 \u060c \u0641\u0642\u0627\u0645 \u0639\u0644\u0649 \u0631\u0621\u0648\u0633\u0647\u0645 \u062b\u0645 \u0642\u0631\u0623\u0647\u0627 \u0639\u0644\u064a\u0647\u0645 \u062d\u062a\u0649 \u0641\u0631\u063a \u0645\u0646 \u0627\u0644\u0633\u0648\u0631\u0629 \u060c \u0641\u0623\u064a\u0633\u0648\u0627 \u0645\u0646\u0647 \u0639\u0646\u062f \u0630\u0644\u0643 \u0648\u0622\u0630\u0648\u0647 \u0648\u0623\u0635\u062d\u0627\u0628\u0647 .\n","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6209,"text":"\u0648\u0645\u0639\u0646\u0649 \u0627\u0644\u0622\u064a\u0629: \"\u0644\u0627 \u0623\u0639\u0628\u062f \u0645\u0627 \u062a\u0639\u0628\u062f\u0648\u0646\"\u060c \u0641\u064a \u0627\u0644\u062d\u0627\u0644.\n","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6210,"text":"\"\u0648\u0644\u0627 \u0623\u0646\u062a\u0645 \u0639\u0627\u0628\u062f\u0648\u0646 \u0645\u0627 \u0623\u0639\u0628\u062f\"\u060c \u0641\u064a \u0627\u0644\u062d\u0627\u0644.\n","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6211,"text":"\"\u0648\u0644\u0627 \u0623\u0646\u0627 \u0639\u0627\u0628\u062f \u0645\u0627 \u0639\u0628\u062f\u062a\u0645\"\u060c \u0641\u064a \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644.\n","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6212,"text":"( \u0648\u0644\u0627 \u0623\u0646\u062a\u0645 \u0639\u0627\u0628\u062f\u0648\u0646 \u0645\u0627 \u0623\u0639\u0628\u062f ) \u0641\u064a \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 .\u0648\u0647\u0630\u0627 \u062e\u0637\u0627\u0628 \u0644\u0645\u0646 \u0633\u0628\u0642 \u0641\u064a \u0639\u0644\u0645 \u0627\u0644\u0644\u0647 \u0623\u0646\u0647\u0645 \u0644\u0627 \u064a\u0624\u0645\u0646\u0648\u0646 .\u0648\u0642\u0648\u0644\u0647 : [ \u0645\u0627 ] \u0623\u0639\u0628\u062f \" \u0623\u064a : \u0645\u0646 \u0623\u0639\u0628\u062f \u060c \u0644\u0643\u0646\u0647 \u0630\u0643\u0631\u0647 \u0644\u0645\u0642\u0627\u0628\u0644\u0629 : \" \u0645\u0627 \u062a\u0639\u0628\u062f\u0648\u0646 \" .\u0648\u0648\u062c\u0647 \u0627\u0644\u062a\u0643\u0631\u0627\u0631 : \u0642\u0627\u0644 \u0623\u0643\u062b\u0631 \u0623\u0647\u0644 \u0627\u0644\u0645\u0639\u0627\u0646\u064a : \u0647\u0648 \u0623\u0646 \u0627\u0644\u0642\u0631\u0622\u0646 \u0646\u0632\u0644 \u0628\u0644\u0633\u0627\u0646 \u0627\u0644\u0639\u0631\u0628 \u060c \u0648\u0639\u0644\u0649 \u0645\u062c\u0627\u0632 \u062e\u0637\u0627\u0628\u0647\u0645 \u060c \u0648\u0645\u0646 \u0645\u0630\u0627\u0647\u0628\u0647\u0645 \u0627\u0644\u062a\u0643\u0631\u0627\u0631 \u060c \u0625\u0631\u0627\u062f\u0629 \u0627\u0644\u062a\u0648\u0643\u064a\u062f \u0648\u0627\u0644\u0625\u0641\u0647\u0627\u0645 \u0643\u0645\u0627 \u0623\u0646 \u0645\u0646 \u0645\u0630\u0627\u0647\u0628\u0647\u0645 \u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631 \u0625\u0631\u0627\u062f\u0629 \u0627\u0644\u062a\u062e\u0641\u064a\u0641 \u0648\u0627\u0644\u0625\u064a\u062c\u0627\u0632 .\u0648\u0642\u0627\u0644 \u0627\u0644\u0642\u062a\u064a\u0628\u064a : \u062a\u0643\u0631\u0627\u0631 \u0627\u0644\u0643\u0644\u0627\u0645 \u0644\u062a\u0643\u0631\u0627\u0631 \u0627\u0644\u0648\u0642\u062a \u060c \u0648\u0630\u0644\u0643 \u0623\u0646\u0647\u0645 \u0642\u0627\u0644\u0648\u0627 : \u0625\u0646 \u0633\u0631\u0643 \u0623\u0646 \u0646\u062f\u062e\u0644 \u0641\u064a \u062f\u064a\u0646\u0643 \u0639\u0627\u0645\u0627 \u0641\u0627\u062f\u062e\u0644 \u0641\u064a \u062f\u064a\u0646\u0646\u0627 \u0639\u0627\u0645\u0627 \u060c \u0641\u0646\u0632\u0644\u062a \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629 .\n","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6213,"text":"( \u0644\u0643\u0645 \u062f\u064a\u0646\u0643\u0645 ) \u0627\u0644\u0634\u0631\u0643 ( \u0648\u0644\u064a \u062f\u064a\u0646 ) \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u060c \u0642\u0631\u0623 \u0627\u0628\u0646 \u0643\u062b\u064a\u0631 \u060c \u0648\u0646\u0627\u0641\u0639 \u060c \u0648\u062d\u0641\u0635 : \" \u0648\u0644\u064a \" \u0628\u0641\u062a\u062d \u0627\u0644\u064a\u0627\u0621 \u060c \u0642\u0631\u0623 \u0627\u0644\u0622\u062e\u0631\u0648\u0646 \u0628\u0625\u0633\u0643\u0627\u0646\u0647\u0627 . [ \u0648\u0647\u0630\u0647 \u0627\u0644\u0622\u064a\u0629 \u0645\u0646\u0633\u0648\u062e\u0629 \u0628\u0622\u064a\u0629 \u0627\u0644\u0633\u064a\u0641 ] .\n","numberInSurah":6,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ar.baghawi","language":"ar","name":"\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0628\u063a\u0648\u064a","englishName":"Tafseer Al-Baghawi","format":"text","type":"tafsir","direction":"rtl"}}]}