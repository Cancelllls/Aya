{"code":200,"status":"OK","data":[{"number":111,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064e\u0633\u064e\u062f\u0650","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u062a\u064e\u0628\u0651\u064e\u062a\u0652 \u064a\u064e\u062f\u064e\u0627\u0653 \u0623\u064e\u0628\u0650\u0649 \u0644\u064e\u0647\u064e\u0628\u064d\u06e2 \u0648\u064e\u062a\u064e\u0628\u0651\u064e","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"\u0645\u064e\u0627\u0653 \u0623\u064e\u063a\u0652\u0646\u064e\u0649\u0670 \u0639\u064e\u0646\u0652\u0647\u064f \u0645\u064e\u0627\u0644\u064f\u0647\u064f\u06e5 \u0648\u064e\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"\u0633\u064e\u064a\u064e\u0635\u0652\u0644\u064e\u0649\u0670 \u0646\u064e\u0627\u0631\u064b\u06ed\u0627 \u0630\u064e\u0627\u062a\u064e \u0644\u064e\u0647\u064e\u0628\u064d\u06e2","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"\u0648\u064e\u0671\u0645\u0652\u0631\u064e\u0623\u064e\u062a\u064f\u0647\u064f\u06e5 \u062d\u064e\u0645\u0651\u064e\u0627\u0644\u064e\u0629\u064e \u0671\u0644\u0652\u062d\u064e\u0637\u064e\u0628\u0650","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"\u0641\u0650\u0649 \u062c\u0650\u064a\u062f\u0650\u0647\u064e\u0627 \u062d\u064e\u0628\u0652\u0644\u064c\u06ed \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0633\u064e\u062f\u064d\u06ed","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":111,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064e\u0633\u064e\u062f\u0650","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"May the hands of Abu Lahab be ruined, and ruined is he.","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"His wealth will not avail him or that which he gained.","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"He will [enter to] burn in a Fire of [blazing] flame","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"And his wife [as well] - the carrier of firewood.","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"Around her neck is a rope of [twisted] fiber.","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":111,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064e\u0633\u064e\u062f\u0650","englishName":"Al-Masad","englishNameTranslation":"The Palm Fibre","revelationType":"Meccan","numberOfAyahs":5,"ayahs":[{"number":6217,"text":"\u0645\u0643\u064a\u0629( \u062a\u0628\u062a \u064a\u062f\u0627 \u0623\u0628\u064a \u0644\u0647\u0628 \u0648\u062a\u0628 ) \u0623\u062e\u0628\u0631\u0646\u0627 \u0623\u062d\u0645\u062f \u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0627\u0644\u0635\u0627\u0644\u062d\u064a \u060c \u0623\u062e\u0628\u0631\u0646\u0627 \u0623\u0628\u0648 \u0628\u0643\u0631 \u0623\u062d\u0645\u062f \u0628\u0646 \u0627\u0644\u062d\u0633\u0646 \u0627\u0644\u062d\u064a\u0631\u064a \u060c \u0623\u062e\u0628\u0631\u0646\u0627 \u062d\u0627\u062c\u0628 \u0628\u0646 \u0623\u062d\u0645\u062f \u0627\u0644\u0637\u0648\u0633\u064a \u060c \u062d\u062f\u062b\u0646\u0627 \u0645\u062d\u0645\u062f \u0628\u0646 \u062d\u0645\u0627\u062f \u060c \u062d\u062f\u062b\u0646\u0627 \u0623\u0628\u0648 \u0645\u0639\u0627\u0648\u064a\u0629 \u0639\u0646 \u0627\u0644\u0623\u0639\u0645\u0634 \u060c \u0639\u0646 \u0639\u0645\u0631\u0648 \u0628\u0646 \u0645\u0631\u0629 \u060c \u0639\u0646 \u0633\u0639\u064a\u062f \u0628\u0646 \u062c\u0628\u064a\u0631 \u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0642\u0627\u0644 : \u0635\u0639\u062f \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u0630\u0627\u062a \u064a\u0648\u0645 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u0627 \u0641\u0642\u0627\u0644 : \u064a\u0627 \u0635\u0628\u0627\u062d\u0627\u0647 \u060c \u0642\u0627\u0644 : \u0641\u0627\u062c\u062a\u0645\u0639\u062a \u0625\u0644\u064a\u0647 \u0642\u0631\u064a\u0634 \u060c \u0641\u0642\u0627\u0644\u0648\u0627 \u0644\u0647 : \u0645\u0627\u0644\u0643 \u061f \u0642\u0627\u0644 : \u0623\u0631\u0623\u064a\u062a\u0645 \u0644\u0648 \u0623\u062e\u0628\u0631\u062a\u0643\u0645 \u0623\u0646 \u0645\u0635\u0628\u062d\u0643\u0645 \u0623\u0648 \u0645\u0645\u0633\u064a\u0643\u0645 \u0623\u0645\u0627 \u0643\u0646\u062a\u0645 \u062a\u0635\u062f\u0642\u0648\u0646\u064a \u061f \u0642\u0627\u0644\u0648\u0627 : \u0628\u0644\u0649 \u060c \u0642\u0627\u0644 : \u0641\u0625\u0646\u064a \u0646\u0630\u064a\u0631 \u0644\u0643\u0645 \u0628\u064a\u0646 \u064a\u062f\u064a \u0639\u0630\u0627\u0628 \u0634\u062f\u064a\u062f \u060c \u0641\u0642\u0627\u0644 \u0623\u0628\u0648 \u0644\u0647\u0628 : \u062a\u0628\u0627 \u0644\u0643 \u060c \u0623\u0644\u0647\u0630\u0627 \u062f\u0639\u0648\u062a\u0646\u0627 \u062c\u0645\u064a\u0639\u0627 \u061f \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 - \u0639\u0632 \u0648\u062c\u0644 - : \" \u062a\u0628\u062a \u064a\u062f\u0627 \u0623\u0628\u064a \u0644\u0647\u0628 \u0648\u062a\u0628 \" \u0625\u0644\u0649 \u0622\u062e\u0631\u0647\u0627 .\u0642\u0648\u0644\u0647 : ( \u062a\u0628\u062a ) \u0623\u064a : \u062e\u0627\u0628\u062a \u0648\u062e\u0633\u0631\u062a \u064a\u062f\u0627 \u0623\u0628\u064a \u0644\u0647\u0628 \u060c [ \u0623\u064a \u0647\u0648 ] \u060c \u0623\u062e\u0628\u0631 \u0639\u0646 \u064a\u062f\u064a\u0647 \u060c \u0648\u0627\u0644\u0645\u0631\u0627\u062f \u0628\u0647 \u0646\u0641\u0633\u0647 \u0639\u0644\u0649 \u0639\u0627\u062f\u0629 \u0627\u0644\u0639\u0631\u0628 \u0641\u064a \u0627\u0644\u062a\u0639\u0628\u064a\u0631 \u0628\u0628\u0639\u0636 \u0627\u0644\u0634\u064a\u0621 \u0639\u0646 \u0643\u0644\u0647 .\u0648\u0642\u064a\u0644 : \" \u0627\u0644\u064a\u062f \" \u0635\u0644\u0629 \u060c \u0643\u0645\u0627 \u064a\u0642\u0627\u0644 : \u064a\u062f \u0627\u0644\u062f\u0647\u0631 \u0648\u064a\u062f \u0627\u0644\u0631\u0632\u0627\u064a\u0627 \u0648\u0627\u0644\u0628\u0644\u0627\u064a\u0627 .\u0648\u0642\u064a\u0644 : \u0627\u0644\u0645\u0631\u0627\u062f \u0628\u0647\u0627 \u0645\u0627\u0644\u0647 \u0648\u0645\u0644\u0643\u0647 \u060c \u064a\u0642\u0627\u0644 : \u0641\u0644\u0627\u0646 \u0642\u0644\u064a\u0644 \u0630\u0627\u062a \u0627\u0644\u064a\u062f \u060c \u064a\u0639\u0646\u0648\u0646 \u0628\u0647 \u0627\u0644\u0645\u0627\u0644 \u060c \u0648 \" \u0627\u0644\u062a\u0628\u0627\u0628 \" : \u0627\u0644\u062e\u0633\u0627\u0631 \u0648\u0627\u0644\u0647\u0644\u0627\u0643 .\u0648\u0623\u0628\u0648 \u0644\u0647\u0628 : \u0647\u0648 \u0627\u0628\u0646 \u0639\u0628\u062f \u0627\u0644\u0645\u0637\u0644\u0628 \u0639\u0645 \u0627\u0644\u0646\u0628\u064a - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u0648\u0627\u0633\u0645\u0647 \u0639\u0628\u062f \u0627\u0644\u0639\u0632\u0649 . \u0642\u0627\u0644 \u0645\u0642\u0627\u062a\u0644 : \u0643\u0646\u064a \u0628\u0623\u0628\u064a \u0644\u0647\u0628 \u0644\u062d\u0633\u0646\u0647 \u0648\u0625\u0634\u0631\u0627\u0642 \u0648\u062c\u0647\u0647 .\u0648\u0642\u0631\u0623 \u0627\u0628\u0646 \u0643\u062b\u064a\u0631 \" \u0623\u0628\u064a \u0644\u0647\u0628 \" \u0633\u0627\u0643\u0646\u0629 \u0627\u0644\u0647\u0627\u0621 \u060c \u0648\u0647\u064a \u0645\u062b\u0644 : \u0646\u0647\u0631 \u0648\u0646\u0647\u0631 . \u0648\u0627\u062a\u0641\u0642\u0648\u0627 \u0641\u064a \" \u0630\u0627\u062a \u0644\u0647\u0628 \" \u0623\u0646\u0647\u0627 \u0645\u0641\u062a\u0648\u062d\u0629 \u0627\u0644\u0647\u0627\u0621 \u0644\u0648\u0641\u0627\u0642 \u0627\u0644\u0641\u0648\u0627\u0635\u0644 .( \u0648\u062a\u0628 ) \u0623\u0628\u0648 \u0644\u0647\u0628 \u060c \u0648\u0642\u0631\u0623 \u0639\u0628\u062f \u0627\u0644\u0644\u0647 : \u0648\u0642\u062f \u062a\u0628 . \u0642\u0627\u0644 \u0627\u0644\u0641\u0631\u0627\u0621 : \u0627\u0644\u0623\u0648\u0644 \u062f\u0639\u0627\u0621 \u060c \u0648\u0627\u0644\u062b\u0627\u0646\u064a \u062e\u0628\u0631 \u060c \u0643\u0645\u0627 \u064a\u0642\u0627\u0644 : \u0623\u0647\u0644\u0643\u0647 \u0627\u0644\u0644\u0647 \u060c \u0648\u0642\u062f \u0641\u0639\u0644 .\n","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6218,"text":"( \u0645\u0627 \u0623\u063a\u0646\u0649 \u0639\u0646\u0647 \u0645\u0627\u0644\u0647 \u0648\u0645\u0627 \u0643\u0633\u0628 ) \u0642\u0627\u0644 \u0627\u0628\u0646 \u0645\u0633\u0639\u0648\u062f : \u0644\u0645\u0627 \u062f\u0639\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u0623\u0642\u0631\u0628\u0627\u0621\u0647 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 - \u0639\u0632 \u0648\u062c\u0644 - \u0642\u0627\u0644 \u0623\u0628\u0648 \u0644\u0647\u0628 : \u0625\u0646 \u0643\u0627\u0646 \u0645\u0627 \u064a\u0642\u0648\u0644 \u0627\u0628\u0646 \u0623\u062e\u064a \u062d\u0642\u0627 \u0641\u0625\u0646\u064a \u0623\u0641\u062a\u062f\u064a \u0646\u0641\u0633\u064a \u0648\u0645\u0627\u0644\u064a \u0648\u0648\u0644\u062f\u064a \u060c \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u062a\u0639\u0627\u0644\u0649 :( \u0645\u0627 \u0623\u063a\u0646\u0649 \u0639\u0646\u0647 \u0645\u0627\u0644\u0647 ) \u0623\u064a \u0645\u0627 \u064a\u063a\u0646\u064a \u060c \u0648\u0642\u064a\u0644 : \u0623\u064a \u0634\u064a\u0621 \u064a\u063a\u0646\u064a \u0639\u0646\u0647 \u0645\u0627\u0644\u0647 \u060c \u0623\u064a : \u0645\u0627 \u064a\u062f\u0641\u0639 \u0639\u0646\u0647 \u0639\u0630\u0627\u0628 \u0627\u0644\u0644\u0647 \u0645\u0627 \u062c\u0645\u0639 \u0645\u0646 \u0627\u0644\u0645\u0627\u0644 \u060c \u0648\u0643\u0627\u0646 \u0635\u0627\u062d\u0628 \u0645\u0648\u0627\u0634 ( \u0648\u0645\u0627 \u0643\u0633\u0628 ) \u0642\u064a\u0644 : \u064a\u0639\u0646\u064a \u0648\u0644\u062f\u0647 \u060c \u0644\u0623\u0646 \u0648\u0644\u062f \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0645\u0646 \u0643\u0633\u0628\u0647 \u0643\u0645\u0627 \u062c\u0627\u0621 \u0641\u064a \u0627\u0644\u062d\u062f\u064a\u062b : \" \u0623\u0637\u064a\u0628 \u0645\u0627 \u064a\u0623\u0643\u0644 \u0623\u062d\u062f\u0643\u0645 \u0645\u0646 \u0643\u0633\u0628\u0647 \u060c \u0648\u0625\u0646 \u0648\u0644\u062f\u0647 \u0645\u0646 \u0643\u0633\u0628\u0647 \"\n","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6219,"text":"\u062b\u0645 \u0623\u0648\u0639\u062f\u0647 \u0628\u0627\u0644\u0646\u0627\u0631 \u0641\u0642\u0627\u0644 : ( \u0633\u064a\u0635\u0644\u0649 \u0646\u0627\u0631\u0627 \u0630\u0627\u062a \u0644\u0647\u0628 ) \u0623\u064a \u0646\u0627\u0631\u0627 \u062a\u0644\u062a\u0647\u0628 \u0639\u0644\u064a\u0647 .\n","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6220,"text":"( \u0648\u0627\u0645\u0631\u0623\u062a\u0647 ) \u0623\u0645 \u062c\u0645\u064a\u0644 \u0628\u0646\u062a \u062d\u0631\u0628 \u0628\u0646 \u0623\u0645\u064a\u0629 \u0623\u062e\u062a \u0623\u0628\u064a \u0633\u0641\u064a\u0627\u0646 ( \u062d\u0645\u0627\u0644\u0629 \u0627\u0644\u062d\u0637\u0628 ) \u0642\u0627\u0644 \u0627\u0628\u0646 \u0632\u064a\u062f \u0648\u0627\u0644\u0636\u062d\u0627\u0643 : \u0643\u0627\u0646\u062a \u062a\u062d\u0645\u0644 \u0627\u0644\u0634\u0648\u0643 \u0648\u0627\u0644\u0639\u0636\u0627\u0629 \u0641\u062a\u0637\u0631\u062d\u0647 \u0641\u064a \u0637\u0631\u064a\u0642 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - \u060c \u0648\u0623\u0635\u062d\u0627\u0628\u0647 \u0644\u062a\u0639\u0642\u0631\u0647\u0645 \u060c \u0648\u0647\u064a \u0631\u0648\u0627\u064a\u0629 \u0639\u0637\u064a\u0629 \u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 .\u0648\u0642\u0627\u0644 \u0642\u062a\u0627\u062f\u0629 \u060c \u0648\u0645\u062c\u0627\u0647\u062f \u060c \u0648\u0627\u0644\u0633\u062f\u064a : \u0643\u0627\u0646\u062a \u062a\u0645\u0634\u064a \u0628\u0627\u0644\u0646\u0645\u064a\u0645\u0629 \u0648\u062a\u0646\u0642\u0644 \u0627\u0644\u062d\u062f\u064a\u062b \u0641\u062a\u0644\u0642\u064a \u0627\u0644\u0639\u062f\u0627\u0648\u0629 \u0628\u064a\u0646 \u0627\u0644\u0646\u0627\u0633 \u060c \u0648\u062a\u0648\u0642\u062f \u0646\u0627\u0631\u0647\u0627 \u0643\u0645\u0627 \u062a\u0648\u0642\u062f \u0627\u0644\u0646\u0627\u0631 [ \u0628\u0627\u0644\u062d\u0637\u0628 ] . \u064a\u0642\u0627\u0644 : \u0641\u0644\u0627\u0646 \u064a\u062d\u0637\u0628 \u0639\u0644\u0649 \u0641\u0644\u0627\u0646 \u060c \u0625\u0630\u0627 \u0643\u0627\u0646 \u064a\u063a\u0631\u064a \u0628\u0647 .\u0648\u0642\u0627\u0644 \u0633\u0639\u064a\u062f \u0628\u0646 \u062c\u0628\u064a\u0631 : \u062d\u0645\u0627\u0644\u0629 \u0627\u0644\u062e\u0637\u0627\u064a\u0627 \u060c \u062f\u0644\u064a\u0644\u0647 : \u0642\u0648\u0644\u0647 : \" \u0648\u0647\u0645 \u064a\u062d\u0645\u0644\u0648\u0646 \u0623\u0648\u0632\u0627\u0631\u0647\u0645 \u0639\u0644\u0649 \u0638\u0647\u0648\u0631\u0647\u0645 \" ( \u0627\u0644\u0623\u0646\u0639\u0627\u0645 - 31 ) .\u0642\u0631\u0623 \u0639\u0627\u0635\u0645 \" \u062d\u0645\u0627\u0644\u0629 \" \u0628\u0627\u0644\u0646\u0635\u0628 \u0639\u0644\u0649 \u0627\u0644\u0630\u0645 \u060c \u0643\u0642\u0648\u0644\u0647 : \" \u0645\u0644\u0639\u0648\u0646\u064a\u0646 \" .\u0648\u0642\u0631\u0623 . \u0627\u0644\u0622\u062e\u0631\u0648\u0646 \u0628\u0627\u0644\u0631\u0641\u0639 \u060c \u0648\u0644\u0647 \u0648\u062c\u0647\u0627\u0646 : \u0623\u062d\u062f\u0647\u0645\u0627 \u0633\u064a\u0635\u0644\u0649 \u0646\u0627\u0631\u0627 \u0647\u0648 \u0648\u0627\u0645\u0631\u0623\u062a\u0647 \u062d\u0645\u0627\u0644\u0629 \u0627\u0644\u062d\u0637\u0628 . \u0648\u0627\u0644\u062b\u0627\u0646\u064a : \u0648\u0627\u0645\u0631\u0623\u062a\u0647 \u062d\u0645\u0627\u0644\u0629 \u0627\u0644\u062d\u0637\u0628 \u0641\u064a \u0627\u0644\u0646\u0627\u0631 \u0623\u064a\u0636\u0627 .\n","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false},{"number":6221,"text":"( \u0641\u064a \u062c\u064a\u062f\u0647\u0627 ) \u0641\u064a \u0639\u0646\u0642\u0647\u0627 \u060c \u0648\u062c\u0645\u0639\u0647 \u0623\u062c\u064a\u0627\u062f \u060c ( \u062d\u0628\u0644 \u0645\u0646 \u0645\u0633\u062f ) \u0648\u0627\u062e\u062a\u0644\u0641\u0648\u0627 \u0641\u064a\u0647 \u060c \u0642\u0627\u0644 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u060c \u0648\u0639\u0631\u0648\u0629 \u0628\u0646 \u0627\u0644\u0632\u0628\u064a\u0631 : \u0633\u0644\u0633\u0644\u0629 \u0645\u0646 \u062d\u062f\u064a\u062f \u0630\u0631\u0639\u0647\u0627 \u0633\u0628\u0639\u0648\u0646 \u0630\u0631\u0627\u0639\u0627 \u060c \u062a\u062f\u062e\u0644 \u0641\u064a \u0641\u064a\u0647\u0627 \u0648\u062a\u062e\u0631\u062c \u0645\u0646 \u062f\u0628\u0631\u0647\u0627 \u060c \u0648\u064a\u0643\u0648\u0646 \u0633\u0627\u0626\u0631\u0647\u0627 \u0641\u064a \u0639\u0646\u0642\u0647\u0627 \u060c \u0648\u0623\u0635\u0644\u0647 \u0645\u0646 \" \u0627\u0644\u0645\u0633\u062f \" \u0648\u0647\u0648 \u0627\u0644\u0641\u062a\u0644 \u060c \u0648 \" \u0627\u0644\u0645\u0633\u062f \" \u0645\u0627 \u0641\u062a\u0644 \u0648\u0623\u062d\u0643\u0645 \u0645\u0646 \u0623\u064a \u0634\u064a\u0621 \u0643\u0627\u0646 \u060c \u064a\u0639\u0646\u064a : \u0627\u0644\u0633\u0644\u0633\u0644\u0629 \u0627\u0644\u062a\u064a \u0641\u064a \u0639\u0646\u0642\u0647\u0627 \u0641\u0641\u062a\u0644\u062a \u0645\u0646 \u0627\u0644\u062d\u062f\u064a\u062f \u0641\u062a\u0644\u0627 \u0645\u062d\u0643\u0645\u0627 .\u0648\u0631\u0648\u0649 \u0627\u0644\u0623\u0639\u0645\u0634 \u0639\u0646 \u0645\u062c\u0627\u0647\u062f : \" \u0645\u0646 \u0645\u0633\u062f \" \u0623\u064a \u0645\u0646 \u062d\u062f\u064a\u062f \u060c \u0648\u0627\u0644\u0645\u0633\u062f : \u0627\u0644\u062d\u062f\u064a\u062f\u0629 \u0627\u0644\u062a\u064a \u062a\u0643\u0648\u0646 \u0641\u064a \u0627\u0644\u0628\u0643\u0631\u0629 \u060c \u064a\u0642\u0627\u0644 \u0644\u0647\u0627 \u0627\u0644\u0645\u062d\u0648\u0631 .\u0648\u0642\u0627\u0644 \u0627\u0644\u0634\u0639\u0628\u064a \u0648\u0645\u0642\u0627\u062a\u0644 : \u0645\u0646 \u0644\u064a\u0641 . \u0642\u0627\u0644 \u0627\u0644\u0636\u062d\u0627\u0643 \u0648\u063a\u064a\u0631\u0647 : \u0641\u064a \u0627\u0644\u062f\u0646\u064a\u0627 \u0645\u0646 \u0644\u064a\u0641 \u060c \u0648\u0641\u064a \u0627\u0644\u0622\u062e\u0631\u0629 \u0645\u0646 \u0646\u0627\u0631 . \u0648\u0630\u0644\u0643 \u0627\u0644\u0644\u064a\u0641 \u0647\u0648 \u0627\u0644\u062d\u0628\u0644 \u0627\u0644\u0630\u064a \u0643\u0627\u0646\u062a \u062a\u062d\u062a\u0637\u0628 \u0628\u0647 \u060c \u0641\u0628\u064a\u0646\u0645\u0627 \u0647\u064a \u0630\u0627\u062a \u064a\u0648\u0645 \u062d\u0627\u0645\u0644\u0629 \u062d\u0632\u0645\u0629 \u0641\u0623\u0639\u064a\u062a \u0641\u0642\u0639\u062f\u062a \u0639\u0644\u0649 \u062d\u062c\u0631 \u062a\u0633\u062a\u0631\u064a\u062d \u0641\u0623\u062a\u0627\u0647\u0627 \u0645\u0644\u0643 \u0641\u062c\u0630\u0628\u0647\u0627 \u0645\u0646 \u062e\u0644\u0641\u0647\u0627 \u0641\u0623\u0647\u0644\u0643\u0647\u0627 .\u0642\u0627\u0644 \u0627\u0628\u0646 \u0632\u064a\u062f : \u062d\u0628\u0644 \u0645\u0646 \u0634\u062c\u0631 \u064a\u0646\u0628\u062a \u0628\u0627\u0644\u064a\u0645\u0646 \u064a\u0642\u0627\u0644 \u0644\u0647 \u0645\u0633\u062f .\u0642\u0627\u0644 \u0642\u062a\u0627\u062f\u0629 : \u0642\u0644\u0627\u062f\u0629 \u0645\u0646 \u0648\u062f\u0639 \u0648\u0642\u0627\u0644 \u0627\u0644\u062d\u0633\u0646 : \u0643\u0627\u0646\u062a \u062e\u0631\u0632\u0627\u062a \u0641\u064a \u0639\u0646\u0642\u0647\u0627 [ \u0641\u0627\u062e\u0631\u0629 ] \u0648\u0642\u0627\u0644 \u0633\u0639\u064a\u062f \u0628\u0646 \u0627\u0644\u0645\u0633\u064a\u0628 : \u0643\u0627\u0646\u062a \u0644\u0647\u0627 \u0642\u0644\u0627\u062f\u0629 \u0641\u064a \u0639\u0646\u0642\u0647\u0627 \u0641\u0627\u062e\u0631\u0629 \u060c \u0641\u0642\u0627\u0644\u062a : \u0644\u0623\u0646\u0641\u0642\u0646\u0647\u0627 \u0641\u064a \u0639\u062f\u0627\u0648\u0629 \u0645\u062d\u0645\u062f - \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 - .\n","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":553,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"ar.baghawi","language":"ar","name":"\u062a\u0641\u0633\u064a\u0631 \u0627\u0644\u0628\u063a\u0648\u064a","englishName":"Tafseer Al-Baghawi","format":"text","type":"tafsir","direction":"rtl"}}]}