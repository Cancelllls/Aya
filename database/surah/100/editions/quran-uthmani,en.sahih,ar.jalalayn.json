rd with them, that Day, is [fully] Acquainted.","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":542,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":100,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0639\u064e\u0627\u062f\u0650\u064a\u064e\u0627\u062a\u0650","englishName":"Al-Aadiyaat","englishNameTranslation":"The Chargers","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6147,"text":"\u00ab\u0648\u0627\u0644\u0639\u0627\u062f\u064a\u0627\u062a\u00bb \u0627\u0644\u062e\u064a\u0644 \u062a\u0639\u062f\u0648 \u0641\u064a \u0627\u0644\u063a\u0632\u0648 \u0648\u062a\u0636\u0628\u062d \u00ab\u0636\u0628\u062d\u0627\u00bb \u0647\u0648 \u0635\u0648\u062a \u0623\u062c\u0648\u0627\u0641\u0647\u0627 \u0625\u0630\u0627 \u0639\u062f\u062a.","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6148,"text":"\u00ab\u0641\u0627\u0644\u0645\u0648\u0631\u064a\u0627\u062a\u00bb \u0627\u0644\u062e\u064a\u0644 \u062a\u0648\u0631\u064a \u0627\u0644\u0646\u0627\u0631 \u00ab\u0642\u062f\u062d\u0627\u00bb \u0628\u062d\u0648\u0627\u0641\u0631\u0647\u0627 \u0625\u0630\u0627 \u0633\u0627\u0631\u062a \u0641\u064a \u0627\u0644\u0623\u0631\u0636 \u0630\u0627\u062a \u0627\u0644\u062d\u062c\u0627\u0631\u0629 \u0628\u0627\u0644\u0644\u064a\u0644.","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":542,"hizbQuarter":239,"sajda":false},{"number":6149,"text":"\u00ab\u0641\u0627\u0644\u0645\u063a\u064a\u0631\u0627\u062a \u0635\u0628\u062d\u0627\u00bb \u0627\u0644\u062e\u064a\u0644 \u062a\u063a\u064a\u0631 \u0639\u0644\u0649 \u0627\u0644\u0639\u062f\u0648 \u0648\u0642\u062a \u0627\u0644\u0635\u0628\u062d \u0628\u0625\u063a\u0627\u0631\u0629 \u0623\u0635\u062d\u0627\u0628\u0647\u0627.","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":5