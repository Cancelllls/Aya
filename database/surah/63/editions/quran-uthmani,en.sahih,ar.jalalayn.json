u064e \u0631\u064e\u0628\u0651\u0650 \u0644\u064e\u0648\u0652\u0644\u064e\u0627\u0653 \u0623\u064e\u062e\u0651\u064e\u0631\u0652\u062a\u064e\u0646\u0650\u0649\u0653 \u0625\u0650\u0644\u064e\u0649\u0670\u0653 \u0623\u064e\u062c\u064e\u0644\u064d\u06e2 \u0642\u064e\u0631\u0650\u064a\u0628\u064d\u06e2 \u0641\u064e\u0623\u064e\u0635\u0651\u064e\u062f\u0651\u064e\u0642\u064e \u0648\u064e\u0623\u064e\u0643\u064f\u0646 \u0645\u0651\u0650\u0646\u064e \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u0650\u064a\u0646\u064e","numberInSurah":10,"juz":28,"manzil":7,"page":555,"ruku":489,"hizbQuarter":222,"sajda":false},{"number":5199,"text":"\u0648\u064e\u0644\u064e\u0646 \u064a\u064f\u0624\u064e\u062e\u0651\u0650\u0631\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064f \u0646\u064e\u0641\u0652\u0633\u064b\u0627 \u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e \u0623\u064e\u062c\u064e\u0644\u064f\u0647\u064e\u0627 \u06da \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u062e\u064e\u0628\u0650\u064a\u0631\u064c\u06e2 \u0628\u0650\u0645\u064e\u0627 \u062a\u064e\u0639\u0652\u0645\u064e\u0644\u064f\u0648\u0646\u064e","numberInSurah":11,"juz":28,"manzil":7,"page":555,"ruku":489,"hizbQuarter":222,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":63,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064f\u0646\u064e\u0627\u0641\u0650\u0642\u064f\u0648\u0646\u064e","englishName":"Al-Munaafiqoon","englishNameTranslation":"The Hypocrites","revelationType":"Medinan","numberOfAyahs":11,"ayahs":[{"number":5189,"text":"When the hypocrites come to you, [O Muhammad], they say, \"We testify that you are the Messenger of Allah.\" And Allah knows that you are His Messenger, and Allah testifies that the hypocrites are liars.","numberInSurah":1,"juz":28,"manzil":7,"page":554,"ruku":488,"hizbQuarter":221,"sajda":false},{"number":5190,"text":"They have taken their oaths as a cover, so they averted [people] from the way of Allah. Indeed, it was evil that they were doing.","numberInSurah":2,"juz":28,"manzil":7,"page":554,"ruku":488,"hizbQuarter":221,"sajda":false},{"number":5191,"text":"That is because they believed, and then they disbelieved; so their hearts were sealed over, and they do not understand.","numberInSurah":3,"juz":28,"manzil":7,"page":554,"ruku":488,"hizbQuarter":221,"sajda":false},{"number":5192,"text":"And when you see them, their forms please you, and if they speak, you listen to their speech. [They are] as if they were pieces of wood propped up - they think that every shout is against them. They are the enemy, so beware of them. May Allah destroy them; how are they deluded?","numberInSurah":4,"juz":28,"manzil":7,"page":554,"ruku":488,"hizbQuarter":222,"sajda":false},{"number":5193,"text":"And when it is said to them, \"Come, the Messenger of Allah will ask forgiveness for you,\" they turn their heads aside and you see them evading while they are arrogant.","numberInSurah":5,"juz":28,"manzil":7,"page":555,"ruku":488,"hizbQuarter":222,"sajda":false},{"number":5194,"text":"It is all the same for them whether you ask forgiveness for them or do not ask forgiveness for them; never will Allah forgive them. Indeed, Allah does not guide the defiantly disobedient people.","numberInSurah":6,"juz":28,"manzil":7,"page":555,"ruku":488,"hizbQuarter":222,"sajda":false},{"number":5195,"text":"They are the ones who say, \"Do not spend on those who are with the Messenger of Allah until they disband.\" And to Allah belongs the depositories of the heavens and the earth, but the hypocrites do not understand.","numberInSurah":7,"juz":28,"manzil":7,"page":555,"ruku":488,"hizbQuarter":222,"sajda":false},{"number":5196,"text":"They say, \"If we return to al-Madinah, the more honored [for power] will surely expel therefrom the more humble.\" And to Allah belongs [all] honor, and to His Messenger, and to the believers, but the hypocrites do not know.","numberInSurah":8,"juz":28,"manzil":7,"page":555,"ruku":488,"hizbQuarter":222,"sajda":false},{"number":5197,"text":"O you who have believed, let not your wealth and your children divert you from remembrance of Allah. And whoever does that - then those are the losers.","numberInSurah":9,"juz":28,"manzil":7,"page":555,"ruku":489,"hizbQuarter":222,"sajda":false},{"number":5198,"text":"And spend [in the way of Allah] from what We have provided you before death approaches one of you and he says, \"My Lord, if only You would delay me for a brief term so I would give charity and be among the righteous.\"","numberInSurah":10,"juz":28,"manzil":7,"page":555,"ruku":489,"hizbQuarter":222,"sajda":false},{"number":5199,"text":"But never will Allah delay a soul when its time has come. And Allah is Acquainted with what you do.","numberInSurah":11,"juz":28,"manzil":7,"page":555,"ruku":489,"hizbQuarter":222,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":63,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064f\u0646\u064e\u0627\u0641\u0650\u0642\u064f\u0648\u0646\u064e","englishName":"Al-Munaafiqoon","englishNameTranslation":"The Hypocrites","revelationType":"Medinan","numberOfAyahs":11,"ayahs":[{"number":5189,"text":"\u00ab\u0625\u0630\u0627 \u062c\u0627\u0621\u0643 \u0627\u0644\u0645\u0646\u0627\u0641\u0642\u0648\u0646 \u0642\u0627\u0644\u0648\u0627\u00bb \u0628\u0623\u0644\u0633\u0646\u062a\u0647\u0645 \u0639\u0644\u0649 \u062e\u0644\u0627\u0641 \u0645\u0627 \u0641\u064a \u0642\u0644\u0648\u0628\u0647\u0645 \u00ab\u0646\u0634\u0647\u062f \u0625\u0646\u0643 \u0644\u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0644\u0647 \u064a\u0639\u0644\u0645 \u0625\u0646\u0643 \u0644\u0631\u0633\u0648\u0644\u0647 \u0648\u0627\u0644\u0644\u0647 \u064a\u0634\u0647\u062f\u00bb \u064a\u0639\u0644\u0645 \u00ab\u0625\u0646 \u0627\u0644\u0645\u0646\u0627\u0641\u0642\u064a\u0646 \u0644\u0643\u0627\u0630\u0628\u0648\u0646\u00bb \u0641\u064a\u0645\u0627 \u0623\u0636\u0645\u0631\u0648\u0647 \u0645\u062e\u0627\u0644\u0641\u0627 \u0644\u0645\u0627 \u0642\u0627\u0644\u0648\u0647.","numberInSurah":1,"juz":28,"manzil":7,"page":554,"ruku":488,"hizbQuarter":221,"sajda":false},{"number":5190,"text":"\u00ab\u0627\u062a\u062e\u0630\u0648\u0627 \u0623\u064e\u064a\u0652\u0645\u0627\u0646\u0647\u0645 \u062c\u064f\u0646\u0651\u064e\u0629\u064b\u00bb \u0633\u062a\u0631\u0629 \u0639\u0644\u0649 \u0623\u0645\u0648\u0627\u0644\u0647\u0645 \u0648\u062f\u0645\u0627\u0626\u0647\u0645 \u00ab\u0641\u0635\u062f\u0648\u0627\u00bb \u0628\u0647\u0627 \u00ab\u0639\u0646 \u0633\u0628\u064a\u0644 \u0627\u0644\u0644\u0647\u00bb \u0623\u064a \u0639\u0646 \u0627\u0644\u062c\u0647\u0627\u062f \u0641\u064a\u0647\u0645 \u00ab\u0625\u0646\u0647\u0645 \u0633\u0627\u0621 \u0645\u0627 \u0643\u0627\u0646\u0648\u0627 \u064a\u0639\u0645\u0644\u0648\u0646\u00bb.","numberInSurah":2,"juz":28,"manzil":7,"page":554,"ruku":488,"hizbQuarter":221,"sajda":false},{"number":5191,"text":"\u00ab\u0630\u0644\u0643\u00bb \u0623\u064a \u0633\u0648\u0621 \u0639\u0645\u0644\u0647\u0645 \u00ab\u0628\u0623\u0646\u0647\u0645 \u0622\u0645\u0646\u0648\u0627\u00bb \u0628\u0627\u0644\u0644\u0633\u0627\u0646 \u00ab\u062b\u0645 \u0643\u0641\u0631\u0648\u0627\u00bb \u0628\u0627\u0644\u0642\u0644\u0628\u060c \u0623\u064a \u0627\u0633\u062a\u0645\u0631\u0648\u0627 \u0639\u0644\u0649 \u0643\u0641\u0631\u0647\u0645 \u0628\u0647 \u00ab\u0641\u0637\u0628\u0639\u00bb \u062e\u062a\u0645 \u00ab\u0639\u0644\u0649 \u0642\u0644\u0648\u0628\u0647\u0645\u00bb \u0628\u0627\u0644\u0643\u0641\u0631 \u00ab\u0641\u0647\u0645 \u0644\u0627 \u064a\u0641\u0642\u0647\