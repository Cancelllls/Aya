{"code":200,"status":"OK","data":[{"number":63,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064f\u0646\u064e\u0627\u0641\u0650\u0642\u064f\u0648\u0646\u064e","englishName":"Al-Munaafiqoon","englishNameTranslation":"The Hypocrites","revelationType":"Medinan","numberOfAyahs":11,"ayahs":[{"number":5189,"text":"\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e\u0643\u064e \u0671\u0644\u0652\u0645\u064f\u0646\u064e\u0670\u0641\u0650\u0642\u064f\u0648\u0646\u064e \u0642\u064e\u0627\u0644\u064f\u0648\u0627\u06df \u0646\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0644\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u06d7 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u064a\u064e\u0639\u0652\u0644\u064e\u0645\u064f \u0625\u0650\u0646\u0651\u064e\u0643\u064e \u0644\u064e\u0631\u064e\u0633\u064f\u0648\u0644\u064f\u0647\u064f\u06e5 \u0648\u064e\u0671\u0644\u0644\u0651\u064e\u0647\u064f \u064a\u064e\u0634\u0652\u0647\u064e\u062f\u064f \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0652\u0645\u064f\u0646\u064e\u0670\u0641\u0650\u0642\u0650\u064a\u0646\u064e \u0644\u064e\u0643\u064e\u0670\u0630\u0650\u0628\u064f\u0648\u0646\u064e","numberInSurah":1,"juz":28,"manzil":7,"page":554,"ruku":488,"hizbQuarter":221,"sajda":false},{"number":5190,"text":"\u0671\u062a\u0651\u064e\u062e\u064e\u0630\u064f\u0648\u0653\u0627\u06df \u0623\u064e\u064a\u0652\u0645\u064e\u0670\u0646\u064e\u0647\u064f\u0645\u0652 \u062c\u064f\u0646\u0651\u064e\u0629\u064b\u06ed \u0641\u064e\u0635\u064e\u062f\u0651\u064f\u0648\u0627\u06df \u0639\u064e\u0646 \u0633\u064e\u0628\u0650\u064a\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u06da \u0625\u0650\u0646\u0651