l":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5848,"text":"\u064a\u064e\u0648\u0652\u0645\u064e \u0644\u064e\u0627 \u062a\u064e\u0645\u0652\u0644\u0650\u0643\u064f \u0646\u064e\u0641\u0652\u0633\u064c\u06ed \u0644\u0651\u0650\u0646\u064e\u0641\u0652\u0633\u064d\u06e2 \u0634\u064e\u064a\u0652\u0640\u0654\u064b\u06ed\u0627 \u06d6 \u0648\u064e\u0671\u0644\u0652\u0623\u064e\u0645\u0652\u0631\u064f \u064a\u064e\u0648\u0652\u0645\u064e\u0626\u0650\u0630\u064d\u06e2 \u0644\u0651\u0650\u0644\u0651\u064e\u0647\u0650","numberInSurah":19,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":82,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0627\u0646\u0641\u0650\u0637\u064e\u0627\u0631\u0650","englishName":"Al-Infitaar","englishNameTranslation":"The Cleaving","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":5830,"text":"When the sky breaks apart","numberInSurah":1,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5831,"text":"And when the stars fall, scattering,","numberInSurah":2,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5832,"text":"And when the seas are erupted","numberInSurah":3,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5833,"text":"And when the [contents of] graves are scattered,","numberInSurah":4,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5834,"text":"A soul will [then] know what it has put forth and kept back.","numberInSurah":5,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5835,"text":"O mankind, what has deceived you concerning your Lord, the Generous,","numberInSurah":6,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5836,"text":"Who created you, proportioned you, and balanced you?","numberInSurah":7,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5837,"text":"In whatever form He willed has He assembled you.","numberInSurah":8,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5838,"text":"No! But you deny the Recompense.","numberInSurah":9,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5839,"text":"And indeed, [appointed] over you are keepers,","numberInSurah":10,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5840,"text":"Noble and recording;","numberInSurah":11,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5841,"text":"They know whatever you do.","numberInSurah":12,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5842,"text":"Indeed, the righteous will be in pleasure,","numberInSurah":13,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5843,"text":"And indeed, the wicked will be in Hellfire.","numberInSurah":14,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5844,"text":"They will [enter to] burn therein on the Day of Recompense,","numberInSurah":15,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5845,"text":"And never therefrom will they be absent.","numberInSurah":16,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5846,"text":"And what can make you know what is the Day of Recompense?","numberInSurah":17,"juz":30,"manzil":7,"page":587,"ruku":524,"hizbQuarter":235,"sajda":false},{"number":5847,"text":"Then, what can make you know what is the Day of 