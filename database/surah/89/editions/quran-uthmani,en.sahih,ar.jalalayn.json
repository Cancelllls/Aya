ge":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6021,"text":"\u0671\u0631\u0652\u062c\u0650\u0639\u0650\u0649\u0653 \u0625\u0650\u0644\u064e\u0649\u0670 \u0631\u064e\u0628\u0651\u0650\u0643\u0650 \u0631\u064e\u0627\u0636\u0650\u064a\u064e\u0629\u064b\u06ed \u0645\u0651\u064e\u0631\u0652\u0636\u0650\u064a\u0651\u064e\u0629\u064b\u06ed","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6022,"text":"\u0641\u064e\u0671\u062f\u0652\u062e\u064f\u0644\u0650\u0649 \u0641\u0650\u0649 \u0639\u0650\u0628\u064e\u0670\u062f\u0650\u0649","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6023,"text":"\u0648\u064e\u0671\u062f\u0652\u062e\u064f\u0644\u0650\u0649 \u062c\u064e\u0646\u0651\u064e\u062a\u0650\u0649","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":89,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0641\u064e\u062c\u06e1\u0631\u0650","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5994,"text":"By the dawn","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5995,"text":"And [by] ten nights","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5996,"text":"And [by] the even [number] and the odd","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5997,"text":"And [by] the night when it passes,","numberInSurah":4,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5998,"text":"Is there [not] in [all] that an oath [sufficient] for one of perception?","numberInSurah":5,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5999,"text":"Have you not considered how your Lord dealt with 'Aad -","numberInSurah":6,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6000,"text":"[With] Iram - who had lofty pillars,","numberInSurah":7,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6001,"text":"The likes of whom had never been created in the land?","numberInSurah":8,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6002,"text":"And [with] Thamud, who carved out the rocks in the valley?","numberInSurah":9,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6003,"text":"And [with] Pharaoh, owner of the stakes? -","numberInSurah":10,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6004,"text":"[All of] whom oppressed within the lands","numberInSurah":11,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6005,"text":"And increased therein the corruption.","numberInSurah":12,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6006,"text":"So your Lord poured upon them a scourge of punishment.","numberInSurah":13,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6007,"text":"Indeed, your Lord is in observation.","numberInSurah":14,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6008,"text":"And as for man, when his Lord tries him and [thus] is generous to him and favors him, he says, \"My Lord has honored me.\"","numberInSurah":15,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6009,"text":"But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\"","numberInSurah":16,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6010,"text":"No! But you do not honor the orphan","numberInSurah":17,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6011,"text":"And you do not encourage one another to feed the poor.","numberInSurah":18,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6012,"text":"And you consume inheritance, devouring [it] altogether,","numberInSurah":19,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6013,"text":"And you love wealth with immense love.","numberInSurah":20,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6014,"text":"No! When the earth has been leveled - pounded and crushed -","numberInSurah":21,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6015,"text":"And your Lord has come and the angels, rank upon rank,","numberInSurah":22,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6016,"text":"And brought [within view], that Day, is Hell - that Day, man will remember, but what good to him will be the remembrance?","numberInSurah":23,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6017,"text":"He will say, \"Oh, I wish I had sent ahead [some good] for my life.\"","numberInSurah":24,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6018,"text":"So on that Day, none will punish [as severely] as His punishment,","numberInSurah":25,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6019,"text":"And none will bind [as severely] as His binding [of the evildoers].","numberInSurah":26,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6020,"text":"[To the righteous it will be said], \"O reassured soul,","numberInSurah":27,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6021,"text":"Return to your Lord, well-pleased and pleasing [to Him],","numberInSurah":28,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6022,"text":"And enter among My [righteous] servants","numberInSurah":29,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":6023,"text":"And enter My Paradise.\"","numberInSurah":30,"juz":30,"manzil":7,"page":594,"ruku":531,"hizbQuarter":237,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":89,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0641\u064e\u062c\u06e1\u0631\u0650","englishName":"Al-Fajr","englishNameTranslation":"The Dawn","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5994,"text":"\u00ab\u0648\u0627\u0644\u0641\u062c\u0631\u00bb \u0623\u064a \u0641\u062c\u0631 \u0643\u0644 \u064a\u0648\u0645.","numberInSurah":1,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5995,"text":"\u00ab\u0648\u0644\u064a\u0627\u0644 \u0639\u0634\u0631\u00bb \u0623\u064a \u0639\u0634\u0631 \u0630\u064a \u0627\u0644\u062d\u062c\u0629.","numberInSurah":2,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5996,"text":"\u00ab\u0648\u0627\u0644\u0634\u0641\u0639\u00bb \u0627\u0644\u0632\u0648\u062c \u00ab\u0648\u0627\u0644\u0648\u062a\u0631\u00bb \u0628\u0641\u062a\u062d \u0627\u0644\u0648\u0627\u0648 \u0648\u0643\u0633\u0631\u0647\u0627 \u0644\u063a\u062a\u0627\u0646: \u0627\u0644\u0641\u0631\u062f.","numberInSurah":3,"juz":30,"manzil":7,"page":593,"ruku":531,"hizbQuarter":237,"sajda":false},{"number":5997,"text":"\u00ab\u0648\u0627\u0644\u0644\u064a\u0644 \u0625\u0630\u0627 \u064a\u0633\u0652\u0631\