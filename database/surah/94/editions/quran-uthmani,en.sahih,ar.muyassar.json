l be] ease.","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"So when you have finished [your duties], then stand up [for worship].","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"And to your Lord direct [your] longing.","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":94,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0634\u0651\u064e\u0631\u06e1\u062d\u0650","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"\u0623\u0644\u0645 \u0646\u0648\u0633\u0639 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0628\u064a- \u0644\u0643 \u0635\u062f\u0631\u0643 \u0644\u0634\u0631\u0627\u0626\u0639 \u0627\u0644\u062f\u064a\u0646\u060c \u0648\u0627\u0644\u062f\u0639\u0648\u0629 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647\u060c \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0641 \u0628\u0645\u0643\u0627\u0631\u0645 \u0627\u0644\u0623\u062e\u0644\u0627\u0642\u060c \u0648\u062d\u0637\u0637\u0646\u0627 \u0639\u0646\u0643 \u0628\u0630\u0644\u0643 \u062d\u0650\u0645\u0652\u0644\u0643 \u0627\u0644\u0630\u064a \u0623\u062b\u0642\u0644 \u0638\u0647\u0631\u0643\u060c \u0648\u062c\u0639\u0644\u0646\u0627\u0643 -\u0628\u0645\u0627 \u0623\u0646\u0639\u0645\u0646\u0627 \u0639\u0644\u064a\u0643 \u0645\u0646 \u0627\u0644\u0645\u0643\u0627\u0631\u0645- \u0641\u064a \u0645\u0646\u0632\u0644\u0629 \u0631\u0641\u064a\u0639\u0629 \u0639\u0627\u0644\u064a\u0629\u061f","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"\u0623\u0644\u0645 \u0646\u0648\u0633\u0639 -\u0623\u064a