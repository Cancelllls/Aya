l be] ease.","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6097,"text":"So when you have finished [your duties], then stand up [for worship].","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6098,"text":"And to your Lord direct [your] longing.","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":94,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0634\u0651\u064e\u0631\u06e1\u062d\u0650","englishName":"Ash-Sharh","englishNameTranslation":"The Consolation","revelationType":"Meccan","numberOfAyahs":8,"ayahs":[{"number":6091,"text":"\u00ab\u0623\u0644\u0645 \u0646\u0634\u0631\u062d\u00bb \u0627\u0633\u062a\u0641\u0647\u0627\u0645 \u062a\u0642\u0631\u064a\u0631 \u0623\u064a \u0634\u0631\u062d\u0646\u0627 \u00ab\u0644\u0643\u00bb \u064a\u0627 \u0645\u062d\u0645\u062f \u00ab\u0635\u062f\u0631\u0643\u00bb \u0628\u0627\u0644\u0646\u0628\u0648\u0629 \u0648\u063a\u064a\u0631\u0647\u0627.","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6092,"text":"\u00ab\u0648\u0648\u0636\u0639\u0646\u0627\u00bb \u062d\u0637\u0637\u0646\u0627 \u00ab\u0639\u0646\u0643 \u0648\u0632\u0631\u0643\u00bb.","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":536,"hizbQuarter":239,"sajda":false},{"number":6093,"text":"(\u0627\u0644\u0630\u064a \u0623\u0646\u0642\u0636) \u0623\u062b\u0642\u0644 (\u0638\u0647\u0631\u0643) \u0648\u0647\u0630\u0627 \u0643\u0642\u0648\u0644\u0647 \u062a\u0639\u0627\u0644\u0649: \"\" \u0644\u064a\u063a\u0641\u0631 \u0644\u0643 \u0627\u0644\u0644\u0647 \u0645\u0627 \u062a\u0642\u062f\u0645 \u0645\u0646 \u0630\u0646\u0628\u0643 \"\".","numberInSurah":3,"juz":30,"manzil