hmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":93,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0636\u0651\u064f\u062d\u064e\u0649\u0670","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"By the morning brightness","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"And [by] the night when it covers with darkness,","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you].","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"And the Hereafter is better for you than the first [life].","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"And your Lord is going to give you, and you will be satisfied.","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"Did He not find you an orphan and give [you] refuge?","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"And He found you lost and guided [you],","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"And He found you poor and made [you] self-sufficient.","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"So as for the orphan, do not oppress [him].","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"And as for the petitioner, do not repel [him].","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"But as for the favor of your Lord, report [it].","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":93,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0636\u0651\u064f\u062d\u064e\u0649\u0670","englishName":"Ad-Dhuhaa","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"\u0623\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0628\u0648\u0642\u062a \u0627\u0644\u0636\u062d\u0649\u060c \u0648\u0627\u0644\u0645\u0631\u0627\u062f \u0628\u0647 \u0627\u0644\u0646\u0647\u0627\u0631 \u0643\u0644\u0647\u060c \u0648\u0628\u0627\u0644\u0644\u064a\u0644 \u0625\u0630\u0627 \u0633\u0643\u0646 \u0628\u0627\u0644\u062e\u0644\u0642 \u0648\u0627\u0634\u062a\u062f \u0638\u0644\u0627\u0645\u0647. \u0648\u064a\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0628\u0645\u0627 \u064a\u0634\u0627\u0621 \u0645\u0646 \u0645\u062e\u0644\u0648\u0642\u0627\u062a\u0647\u060c \u0623\u0645\u0627 \u0627\u0644\u0645\u062e\u0644\u0648\u0642 \u0641\u0644\u0627 \u064a\u062c\u0648\u0632 \u0644\u0647 \u0623\u0646 \u064a\u0642\u0633\u0645 \u0628\u063a\u064a\u0631 \u062e\u0627\u0644\u0642\u0647\u060c \u0641\u0625\u0646 \u0627\u0644\u0642\u0633\u0645 \u0628\u063a\u064a\u0631 \u0627\u0644\u0644\u0647 \u0634\u0631\u0643. \u0645\u0627 \u062a\u0631\u0643\u0643 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0628\u064a- \u0631\u0628\u0643\u060c \u0648\u0645\u0627 \u0623\u0628\u063a\u0636\u0643 \u0628\u0625\u0628\u0637\u0627\u0621 \u0627\u0644\u0648\u062d\u064a \u0639\u0646\u0643.","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"\u0623\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0628\u0648\u0642\u062a \u0627\u0644\u0636\u062d\u0649\u060c \u0648\u0627\u0644\u0645\u0631\u0627\u062f \u0628\u0647 \u0627\u0644\u0646\u0647\u0627\u0631 \u0643\u0644\u0647\u060c \u0648\u0628\u0627\u0644\u0644\u064a\u0644 \u0625\u0630\u0627 \u0633\u0643\u0646 \u0628\u0627\u0644\u062e\u0644\u0642 \u0648\u0627\u0634\u062a\u062f \u0638\u0644\u0627\u0645\u0647. \u0648\u064a\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0628\u0645\u0627 \u064a\u0634\u0627\u0621 \u0645\u0646 \u0645\u062e\u0644\u0648\u0642\u0627\u062a\u0647\u060c \u0623\u0645\u0627 \u0627\u0644\u0645\u062e\u0644\u0648\u0642 \u0641\u0644\u0627 \u064a\u062c\u0648\u0632 \u0644\u0647 \u0623\u0646 \u064a\u0642\u0633\u0645 \u0628\u063a\u064a\u0631 \u062e\u0627\u0644\u0642\u0647\u060c \u0641\u0625\u0646 \u0627\u0644\u0642\u0633\u0645 \u0628\u063a\u064a\u0631 \u0627\u0644\u0644\u0647 \u0634\u0631\u0643. \u0645\u0627 \u062a\u0631\u0643\u0643 -\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0628\u064a- \u0631\u0628\u0643\u060c \u0648\u0645\u0627 \u0623\u0628\u063a\u0636\u0643 \u0628\u0625\u0628\u0637\u0627\u0621 \u0627\u0644\u0648\u062d\u064a \u0639\u0646\u0643.","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"\u0623\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0628\u0648\u0642\u062a \u0627\u0644\u0636\u062d\u0649\u060c \u0648\u0627\u0644\u0645\u0631\u0627\u062f \u0628\u0647 \u0627\u0644\u0646\u0647\u0627\u0631 \u0643\u0644\u0647\u060c \u0648\u0628\u0627\u0644\u0644\u064a\u0644 \u0625\u0630\u0627 \u0633\u0643\u0646 \u0628\u0627\u0644\u062e\u0644\u0642 \u0648\u0627\u0634\u062a\u062f \u0638\u0644\u0627\u0645\u0647. \u0648\u064a\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0628\u0645\u0627 \u064a\u0634\u0627\u0621 \u0645\u0646 \u0645\u062e\u0644\u0648\u0642\u0627\u062a\u0647\u060c \u0623\u0645\u0627 \u0627\u0644\u0645\u062e\u0644\u0648\u0642 \u0641\u0644\u0627 \u064a\u062c\u0648\u0632 \u0644\u0647 \u0623\u0646 \u064a\u0642\u0633\u0645 \u0628\u063a\u064a\u0631 \u062e\u0627\u0644\u0642\u06