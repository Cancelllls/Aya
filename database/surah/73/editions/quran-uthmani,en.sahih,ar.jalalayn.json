u0648\u0647\u064f \u0641\u064e\u062a\u064e\u0627\u0628\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064f\u0645\u0652 \u06d6 \u0641\u064e\u0671\u0642\u0652\u0631\u064e\u0621\u064f\u0648\u0627\u06df \u0645\u064e\u0627 \u062a\u064e\u064a\u064e\u0633\u0651\u064e\u0631\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u0652\u0642\u064f\u0631\u0652\u0621\u064e\u0627\u0646\u0650 \u06da \u0639\u064e\u0644\u0650\u0645\u064e \u0623\u064e\u0646 \u0633\u064e\u064a\u064e\u0643\u064f\u0648\u0646\u064f \u0645\u0650\u0646\u0643\u064f\u0645 \u0645\u0651\u064e\u0631\u0652\u0636\u064e\u0649\u0670 \u06d9 \u0648\u064e\u0621\u064e\u0627\u062e\u064e\u0631\u064f\u0648\u0646\u064e \u064a\u064e\u0636\u0652\u0631\u0650\u0628\u064f\u0648\u0646\u064e \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u064a\u064e\u0628\u0652\u062a\u064e\u063a\u064f\u0648\u0646\u064e \u0645\u0650\u0646 \u0641\u064e\u0636\u0652\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u06d9 \u0648\u064e\u0621\u064e\u0627\u062e\u064e\u0631\u064f\u0648\u0646\u064e \u064a\u064f\u0642\u064e\u0670\u062a\u0650\u0644\u064f\u0648\u0646\u064e \u0641\u0650\u0649 \u0633\u064e\u0628\u0650\u064a\u0644\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u06d6 \u0641\u064e\u0671\u0642\u0652\u0631\u064e\u0621\u064f\u0648\u0627\u06df \u0645\u064e\u0627 \u062a\u064e\u064a\u064e\u0633\u0651\u064e\u0631\u064e \u0645\u0650\u0646\u0652\u0647\u064f \u06da \u0648\u064e\u0623\u064e\u0642\u0650\u064a\u0645\u064f\u0648\u0627\u06df \u0671\u0644\u0635\u0651\u064e\u0644\u064e\u0648\u0670\u0629\u064e \u0648\u064e\u0621\u064e\u0627\u062a\u064f\u0648\u0627\u06df \u0671\u0644\u0632\u0651\u064e\u0643\u064e\u0648\u0670\u0629\u064e \u0648\u064e\u0623\u064e\u0642\u0652\u0631\u0650\u0636\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u0642\u064e\u0631\u0652\u0636\u064b\u0627 \u062d\u064e\u0633\u064e\u0646\u064b\u06ed\u0627 \u06da \u0648\u064e\u0645\u064e\u0627 \u062a\u064f\u0642\u064e\u062f\u0651\u0650\u0645\u064f\u0648\u0627\u06df \u0644\u0650\u0623\u064e\u0646\u0641\u064f\u0633\u0650\u0643\u064f\u0645 \u0645\u0651\u0650\u0646\u0652 \u062e\u064e\u064a\u0652\u0631\u064d\u06e2 \u062a\u064e\u062c\u0650\u062f\u064f\u0648\u0647\u064f \u0639\u0650\u0646\u062f\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0647\u064f\u0648\u064e \u062e\u064e\u064a\u0652\u0631\u064b\u06ed\u0627 \u0648\u064e\u0623\u064e\u0639\u0652\u0638\u064e\u0645\u064e \u0623\u064e\u062c\u0652\u0631\u064b\u06ed\u0627 \u06da \u0648\u064e\u0671\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u064f\u0648\u0627\u06df \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u06d6 \u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0644\u0651\u064e\u0647\u064e \u063a\u064e\u0641\u064f\u0648\u0631\u064c\u06ed \u0631\u0651\u064e\u062d\u0650\u064a\u0645\u064c\u06e2","numberInSurah":20,"juz":29,"manzil":7,"page":575,"ruku":509,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":73,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064f\u0632\u0651\u064e\u0645\u0651\u0650\u0644\u0650","englishName":"Al-Muzzammil","englishNameTranslation":"The Enshrouded One","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":5476,"text":"O you who wraps himself [in clothing],","numberInSurah":1,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5477,"text":"Arise [to pray] the night, except for a little -","numberInSurah":2,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5478,"text":"Half of it - or subtract from it a little","numberInSurah":3,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5479,"text":"Or add to it, and recite the Qur'an with measured recitation.","numberInSurah":4,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5480,"text":"Indeed, We will cast upon you a heavy word.","numberInSurah":5,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5481,"text":"Indeed, the hours of the night are more effective for concurrence [of heart and tongue] and more suitable for words.","numberInSurah":6,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5482,"text":"Indeed, for you by day is prolonged occupation.","numberInSurah":7,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5483,"text":"And remember the name of your Lord and devote yourself to Him with [complete] devotion.","numberInSurah":8,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5484,"text":"[He is] the Lord of the East and the West; there is no deity except Him, so take Him as Disposer of [your] affairs.","numberInSurah":9,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5485,"text":"And be patient over what they say and avoid them with gracious avoidance.","numberInSurah":10,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5486,"text":"And leave Me with [the matter of] the deniers, those of ease [in life], and allow them respite a little.","numberInSurah":11,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5487,"text":"Indeed, with Us [for them] are shackles and burning fire","numberInSurah":12,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5488,"text":"And food that chokes and a painful punishment -","numberInSurah":13,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5489,"text":"On the Day the earth and the mountains will convulse and the mountains will become a heap of sand pouring down.","numberInSurah":14,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5490,"text":"Indeed, We have sent to you a Messenger as a witness upon you just as We sent to Pharaoh a messenger.","numberInSurah":15,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5491,"text":"But Pharaoh disobeyed the messenger, so We seized him with a ruinous seizure.","numberInSurah":16,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5492,"text":"Then how can you fear, if you disbelieve, a Day that will make the children white- haired?","numberInSurah":17,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5493,"text":"The heaven will break apart therefrom; ever is His promise fulfilled.","numberInSurah":18,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5494,"text":"Indeed, this is a reminder, so whoever wills may take to his Lord a way.","numberInSurah":19,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5495,"text":"Indeed, your Lord knows, [O Muhammad], that you stand [in prayer] almost two thirds of the night or half of it or a third of it, and [so do] a group of those with you. And Allah determines [the extent of] the night and the day. He has known that you [Muslims] will not be able to do it and has turned to you in forgiveness, so recite what is easy [for you] of the Qur'an. He has known that there will be among you those who are ill and others traveling throughout the land seeking [something] of the bounty of Allah and others fighting for the cause of Allah. So recite what is easy from it and establish prayer and give zakah and loan Allah a goodly loan. And whatever good you put forward for yourselves - you will find it with Allah. It is better and greater in reward. And seek forgiveness of Allah. Indeed, Allah is Forgiving and Merciful.","numberInSurah":20,"juz":29,"manzil":7,"page":575,"ruku":509,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":73,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064f\u0632\u0651\u064e\u0645\u0651\u0650\u0644\u0650","englishName":"Al-Muzzammil","englishNameTranslation":"The Enshrouded One","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":5476,"text":"\u00ab\u064a\u0627 \u0623\u064a\u0647\u0627 \u0627\u0644\u0645\u0632\u0645\u0644\u00bb \u0627\u0644\u0646\u0628\u064a \u0648\u0623\u0635\u0644\u0647 \u0627\u0644\u0645\u062a\u0632\u0645\u0644 \u0623\u064f\u062f\u063a\u0645\u062a \u0627\u0644\u062a\u0627\u0621 \u0641\u064a \u0627\u0644\u0632\u0627\u064a\u060c \u0623\u064a \u0627\u0644\u0645\u062a\u0644\u0641\u0641 \u0628\u062b\u064a\u0627\u0628\u0647 \u062d\u064a\u0646 \u0645\u062c\u064a\u0621 \u0627\u0644\u0648\u062d\u064a \u0644\u0647 \u062e\u0648\u0641\u0627 \u0645\u0646 \u0644\u0647\u064a\u0628\u062a\u0647.","numberInSurah":1,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5477,"text":"\u00ab\u0642\u0645 \u0627\u0644\u0644\u064a\u0644\u00bb \u0635\u0644 \u00ab\u0625\u0644\u0627 \u0642\u0644\u064a\u0644\u0627\u00bb.","numberInSurah":2,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5478,"text":"\u00ab\u0646\u0635\u0641\u0647\u00bb \u0628\u062f\u0644 \u0645\u0646 \u0642\u0644\u064a\u0644\u0627 \u0648\u0642\u0644\u0651\u064e\u062a\u0647 \u0628\u0627\u0644\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0643\u0644 \u00ab\u0623\u0648 \u0627\u0646\u0642\u0635 \u0645\u0646\u0647\u00bb \u0645\u0646 \u0627\u0644\u0646\u0635\u0641 \u00ab\u0642\u0644\u064a\u0644\u0627\u00bb \u0625\u0644\u0649 \u0627\u0644\u062b\u0644\u062b.","numberInSurah":3,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda"