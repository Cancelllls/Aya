670\u0653\u0626\u0650\u0643\u064e \u0647\u064f\u0645\u064f \u0671\u0644\u0652\u0643\u064e\u0641\u064e\u0631\u064e\u0629\u064f \u0671\u0644\u0652\u0641\u064e\u062c\u064e\u0631\u064e\u0629\u064f","numberInSurah":42,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":80,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0639\u064e\u0628\u064e\u0633\u064e","englishName":"Abasa","englishNameTranslation":"He frowned","revelationType":"Meccan","numberOfAyahs":42,"ayahs":[{"number":5759,"text":"The Prophet frowned and turned away","numberInSurah":1,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5760,"text":"Because there came to him the blind man, [interrupting].","numberInSurah":2,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5761,"text":"But what would make you perceive, [O Muhammad], that perhaps he might be purified","numberInSurah":3,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5762,"text":"Or be reminded and the remembrance would benefit him?","numberInSurah":4,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5763,"text":"As for he who thinks himself without need,","numberInSurah":5,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5764,"text":"To him you give attention.","numberInSurah":6,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5765,"text":"And not upon you [is any blame] if he will not be purified.","numberInSurah":7,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5766,"text":"But as for he who came to you striving [for knowledge]","numberInSurah":8,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5767,"text":"While he fears [Allah],","numberInSurah":9,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5768,"text":"From him you are distracted.","numberInSurah":10,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5769,"text":"No! Indeed, these verses are a reminder;","numberInSurah":11,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5770,"text":"So whoever wills may remember it.","numberInSurah":12,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5771,"text":"[It is recorded] in honored sheets,","numberInSurah":13,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5772,"text":"Exalted and purified,","numberInSurah":14,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5773,"text":"[Carried] by the hands of messenger-angels,","numberInSurah":15,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5774,"text":"Noble and dutiful.","numberInSurah":16,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5775,"text":"Cursed is man; how disbelieving is he.","numberInSurah":17,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5776,"text":"From what substance did He create him?","numberInSurah":18,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5777,"text":"From a sperm-drop He created him and destined for him;","numberInSurah":19,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5778,"text":"Then He eased the way for him;","numberInSurah":20,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5779,"text":"Then He causes his death and provides a grave for him.","numberInSurah":21,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5780,"text":"Then when He wills, He will resurrect him.","numberInSurah":22,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5781,"text":"No! Man has not yet accomplished what He commanded him.","numberInSurah":23,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5782,"text":"Then let mankind look at his food -","numberInSurah":24,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5783,"text":"How We poured down water in torrents,","numberInSurah":25,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5784,"text":"Then We broke open the earth, splitting [it with sprouts],","numberInSurah":26,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5785,"text":"And caused to grow within it grain","numberInSurah":27,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5786,"text":"And grapes and herbage","numberInSurah":28,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5787,"text":"And olive and palm trees","numberInSurah":29,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5788,"text":"And gardens of dense shrubbery","numberInSurah":30,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5789,"text":"And fruit and grass -","numberInSurah":31,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5790,"text":"[As] enjoyment for you and your grazing livestock.","numberInSurah":32,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5791,"text":"But when there comes the Deafening Blast","numberInSurah":33,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5792,"text":"On the Day a man will flee from his brother","numberInSurah":34,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5793,"text":"And his mother and his father","numberInSurah":35,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5794,"text":"And his wife and his children,","numberInSurah":36,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5795,"text":"For every man, that Day, will be a matter adequate for him.","numberInSurah":37,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5796,"text":"[Some] faces, that Day, will be bright -","numberInSurah":38,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5797,"text":"Laughing, rejoicing at good news.","numberInSurah":39,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5798,"text":"And [other] faces, that Day, will have upon them dust.","numberInSurah":40,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5799,"text":"Blackness will cover them.","numberInSurah":41,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5800,"text":"Those are the disbelievers, the wicked ones.","numberInSurah":42,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":80,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0639\u064e\u0628\u064e\u0633\u064e","englishName":"Abasa","englishNameTranslation":"He frowned","revelationType":"Meccan","numberOfAyahs":42,"ayahs":[{"number":5759,"text":"\u00ab\u0639\u0628\u0633\u00bb \u0627\u0644\u0646\u0628\u064a: \u0643\u0644\u062d \u0648\u062c\u0647\u0647 \u00ab\u0648\u062a\u0648\u0644\u0649\u00bb \u0623\u0639\u0631\u0636\u064e \u0644\u0623\u062c\u0644:","numberInSurah":1,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5760,"text":"(\u0623\u0646 \u062c\u0627\u0621\u0647 \u0627\u0644\u0623\u0639\u0645\u0649) \u0639\u0628\u062f \u0627\u0644\u0644\u0647 \u0628\u0646 \u0623\u0645 \u0645\u0643\u062a\u0648\u0645 \u0641\u0642\u0637\u0639\u0647 \u0639\u0645\u0627 \u0647\u0648 \u0645\u0634\u063a\u0648\u0644 \u0628\u0647 \u0645\u0645\u0646 \u064a\u0631\u062c\u0648 \u0625\u0633\u0644\u0627\u0645\u0647 \u0645\u0646 \u0623\u0634\u0631\u0627\u0641 \u0642\u0631\u064a\u0634 \u0627\u0644\u0630\u064a\u0646 \u0647\u0648 \u062d\u0631\u064a\u0635 \u0639\u0644\u0649 \u0625\u0633\u0644\u0627\u0645\u0647\u0645\u060c \u0648\u0644\u0645 \u064a\u062f\u0631 \u0627\u0644\u0623\u0639\u0645\u0649 \u0623\u0646\u0647 \u0645\u0634\u063a\u0648\u0644 \u0628\u0630\u0644\u0643 \u0641\u0646\u0627\u062f\u0627\u0647: \u0639\u0644\u0645\u0646\u064a \u0645\u0645\u0627 \u0639\u0644\u0645\u0643 \u0627\u0644\u0644\u0647\u060c \u0641\u0627\u0646\u0635\u0631\u0641 \u0627\u0644\u0646\u0628\u064a \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645 \u0625\u0644\u0649 \u0628\u064a\u062a\u0647 \u0641\u0639\u0648\u062a\u0628 \u0641\u064a \u0630\u0644\u0643 \u0628\u0645\u0627 \u0646\u0632\u0644 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629\u060c \u0641\u0643\u0627\u0646 \u0628\u0639\u062f \u0630\u0644\u0643 \u064a\u0642\u0648\u0644 \u0644\u0647 \u0625\u0630\u0627 \u062c\u0627\u0621: \"\" \u0645\u0631\u062d\u0628\u0627 \u0628\u0645\u0646 \u0639\u0627\u062a\u0628\u0646\u064a \u0641\u064a\u0647 \u0631\u0628\u064a \"\" \u0648\u064a\u0628\u0633\u0637 \u0644\u0647 \u0631\u062f\u0627\u0621\u0647.","numberInSurah":2,"juz":30,"manzil":7,"page":585,"ruku":522,"hizbQuarter":234,"sajda":false},{"number":5761,"text":"\u00ab\u0648\u0645\u0627 \u064a\u064f\u062f\u0631\u064a\u0643\u00bb \u064a\u0639\u0644