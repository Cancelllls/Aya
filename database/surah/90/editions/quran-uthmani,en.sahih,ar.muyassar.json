9\u0650","numberInSurah":18,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6042,"text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u06df \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0647\u064f\u0645\u0652 \u0623\u064e\u0635\u0652\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u0652\u0645\u064e\u0634\u0652\u0640\u0654\u064e\u0645\u064e\u0629\u0650","numberInSurah":19,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6043,"text":"\u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0646\u064e\u0627\u0631\u064c\u06ed \u0645\u0651\u064f\u0624\u0652\u0635\u064e\u062f\u064e\u0629\u064c\u06e2","numberInSurah":20,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-uthmani","language":"ar","name":"\u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064a\u0645 \u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":90,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0628\u064e\u0644\u064e\u062f\u0650","englishName":"Al-Balad","englishNameTranslation":"The City","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":6024,"text":"I swear by this city, Makkah -","numberInSurah":1,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6025,"text":"And you, [O Muhammad], are free of restriction in this city -","numberInSurah":2,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6026,"text":"And [by] the father and that which was born [of him],","numberInSurah":3,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6027,"text":"We have certainly created man into hardship.","numberInSurah":4,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6028,"text":"Does he think that never will anyone overcome him?","numberInSurah":5,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6029,"text":"He says, \"I have spent wealth in abundance.\"","numberInSurah":6,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6030,"text":"Does he think that no one has seen him?","numberInSurah":7,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6031,"text":"Have We not made for him two eyes?","numberInSurah":8,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6032,"text":"And a tongue and two lips?","numberInSurah":9,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6033,"text":"And have shown him the two ways?","numberInSurah":10,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6034,"text":"But he has not broken through the difficult pass.","numberInSurah":11,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6035,"text":"And what can make you know what is [breaking through] the difficult pass?","numberInSurah":12,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6036,"text":"It is the freeing of a slave","numberInSurah":13,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6037,"text":"Or feeding on a day of severe hunger","numberInSurah":14,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6038,"text":"An orphan of near relationship","numberInSurah":15,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6039,"text":"Or a needy person in misery","numberInSurah":16,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6040,"text":"And then being among those who believed and advised one another to patience and advised one another to compassion.","numberInSurah":17,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6041,"text":"Those are the companions of the right.","numberInSurah":18,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6042,"text":"But they who disbelieved in Our signs - those are the companions of the left.","numberInSurah":19,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6043,"text":"Over them will be fire closed in.","numberInSurah":20,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"en.sahih","language":"en","name":"Saheeh International","englishName":"Saheeh International","format":"text","type":"translation","direction":"ltr"}},{"number":90,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0628\u064e\u0644\u064e\u062f\u0650","englishName":"Al-Balad","englishNameTranslation":"The City","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":6024,"text":"\u0623\u0642\u0633\u0645 \u0627\u0644\u0644\u0647 \u0628\u0647\u0630\u0627 \u0627\u0644\u0628\u0644\u062f \u0627\u0644\u062d\u0631\u0627\u0645\u060c \u0648\u0647\u0648 \"\u0645\u0643\u0629\"\u060c \u0648\u0623\u0646\u062a -\u0623\u064a\u0647\u0627 \u0627\u0644\u0646\u0628\u064a- \u0645\u0642\u064a\u0645 \u0641\u064a \u0647\u0630\u0627 \"\u0627\u0644\u0628\u0644\u062f \u0627\u0644\u062d\u0631\u0627\u0645\"\u060c \u0648\u0623\u0642\u0633\u0645 \u0628\u0648\u0627\u0644\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629- \u0648\u0647\u0648 \u0622\u062f\u0645 \u0639\u0644\u064a\u0647 \u0627\u0644\u0633\u0644\u0627\u0645- \u0648\u0645\u0627 \u062a\u0646\u0627\u0633\u0644 \u0645\u0646\u0647 \u0645\u0646 \u0648\u0644\u062f\u060c \u0644\u0642\u062f \u062e\u0644\u0642\u0646\u0627 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0641\u064a \u0634\u062f\u0629 \u0648\u0639\u064