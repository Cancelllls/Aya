{"code":200,"status":"OK","data":[{"number":62,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u062c\u064f\u0645\u064f\u0639\u064e\u0629\u0650","englishName":"Al-Jumu'a","englishNameTranslation":"Friday","revelationType":"Medinan","numberOfAyahs":11,"ayahs":[{"number":5178,"text":"\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u064a\u064f\u0633\u064e\u0628\u0651\u0650\u062d\u064f \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0633\u0651\u064e\u0645\u064e\u0670\u0648\u064e\u0670\u062a\u0650 \u0648\u064e\u0645\u064e\u0627 \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650 \u0671\u0644\u0652\u0645\u064e\u0644\u0650\u0643\u0650 \u0671\u0644\u0652\u0642\u064f\u062f\u0651\u064f\u0648\u0633\u0650 \u0671\u0644\u0652\u0639\u064e\u0632\u0650\u064a\u0632\u0650 \u0671\u0644\u0652\u062d\u064e\u0643\u0650\u064a\u0645\u0650","numberInSurah":1,"juz":28,"manzil":7,"page":553,"ruku":486,"hizbQuarter":221,"sajda":false},{"number":5179,"text":"\u0647\u064f\u0648\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u0628\u064e\u0639\u064e\u062b\u064e \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064f\u0645\u0651\u0650\u064a\u0651\u0650\u06e6\u0646\u064e \u0631\u064e\u0633\u064f\u0648\u0644\u064b\u06ed\u0627 \u0645\u0651\u0650\u0646\u0652\u0647\u064f\u0645\u0652 \u064a\u064e\u062a\u0652\u0644\u064f\u0648\u0627\u06df \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0621\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0647\u0650\u06e6 \u0648\u064e\u064a\u064f\u0632\u064e\u0643\u0651\u0650\u064a\u0647\u0650\u0645\u0652 \u0648\u064e\u064a\u064f\u0639\u064e\u0644\u0651\u0650\u0645\u064f\u0647\u064f\u0645\u064f \u0671\u0644\u0652\u0643\u0650\u062a\u064e\u0670\u0628\u064e \u0648\u064e\u0671\u0644\u0652\u062d\u0650\u0643\u0652\u0645\u064e\u